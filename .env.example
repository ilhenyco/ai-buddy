# Optional RAG stack. Replace with a random token, at least 24 characters.
RAG_SERVICE_TOKEN=replace-with-a-random-token-at-least-24-characters
# Materials of the lead (screen «Материалы») go to the knowledge service's ingestion queue.
# Generate a pair once: python knowledge/examples/keygen.py
#   RAG_SOURCES_TOKEN       <- "Client token" (Go uses it, never the browser)
#   RAG_EXTERNAL_CLIENTS    <- "Server token_sha256" in the JSON below (Python stores only the hash)
# Empty token: materials are saved, but not indexed ("search is not connected" on the screen).
RAG_SOURCES_TOKEN=
RAG_EXTERNAL_CLIENTS={}
# RAG_EXTERNAL_CLIENTS={"homych-go":{"token_sha256":"<64 hex>","scopes":["documents:write"],"expires_at":"2027-12-31T00:00:00Z"}}
# Demo only: a DIFFERENT MCP token -> existing intern user ID.
RAG_MCP_TOKENS={}
RAG_SYNTHETIC_SUBJECTS=[]
RAG_PROVIDER=ollama
# Mac: run Ollama natively (GPU) and point the service at it; empty = the ollama container
# RAG_OLLAMA_URL=http://host.docker.internal:11434
# Starting budgets for a local CPU experiment, not an SLA.
RAG_EMBEDDING_TIMEOUT=120
RAG_GENERATION_TIMEOUT=180
RAG_REQUEST_TIMEOUT=240
RAG_DEMO_TIMEOUT=250
# Go waits for an answer longer than the service's own budget (RAG_REQUEST_TIMEOUT).
RAG_CLIENT_TIMEOUT=270s
