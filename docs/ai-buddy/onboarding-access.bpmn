<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Access" targetNamespace="https://ai-buddy.example/bpmn" exporter="AI-buddy analysis">
  <bpmn:collaboration id="Collaboration_Access">
    <bpmn:participant id="Pool_Access" name="03 · Корпоративные доступы" processRef="Process_Access" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Access" name="03 · Корпоративные доступы" isExecutable="false">
    <bpmn:laneSet id="Lanes_Access">
      <bpmn:lane id="Access_intern" name="Стажёр">
        <bpmn:flowNodeRef>D26</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D27</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D29A</bpmn:flowNodeRef>
