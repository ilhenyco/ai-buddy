        <bpmn:flowNodeRef>D34</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D35</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D40</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D41</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D42</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D43</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D44</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="D26" name="Открыты «Доступы»">
      <bpmn:outgoing>Flow_D26_D27</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="D27" name="Выбрать корпоративный ресурс">
      <bpmn:incoming>Flow_D26_D27</bpmn:incoming>
      <bpmn:outgoing>Flow_D27_D28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="D28" name="Проверить права и найти заявку">
      <bpmn:incoming>Flow_D27_D28</bpmn:incoming>
      <bpmn:outgoing>Flow_D28_D28A</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D28A" name="Запрос разрешён?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D28_D28A</bpmn:incoming>
      <bpmn:outgoing>Flow_D28A_D29</bpmn:outgoing>
      <bpmn:outgoing>Flow_D28A_D28B</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="D28B" name="Показать, что ресурс недоступен">
      <bpmn:incoming>Flow_D28A_D28B</bpmn:incoming>
      <bpmn:outgoing>Flow_D28B_D28C</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="D28C" name="Ресурс недоступен">
      <bpmn:incoming>Flow_D28B_D28C</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="D29" name="Попытка уже есть?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D28A_D29</bpmn:incoming>
      <bpmn:outgoing>Flow_D29_D29A</bpmn:outgoing>
      <bpmn:outgoing>Flow_D29_D30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D29A" name="Проверить статус или повторить">
      <bpmn:incoming>Flow_D29_D29A</bpmn:incoming>
      <bpmn:outgoing>Flow_D29A_D33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="D30" name="Подготовить и показать черновик">
      <bpmn:incoming>Flow_D29_D30</bpmn:incoming>
      <bpmn:outgoing>Flow_D30_D31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D31" name="Стажёр подтверждает?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D30_D31</bpmn:incoming>
      <bpmn:outgoing>Flow_D31_D32</bpmn:outgoing>
      <bpmn:outgoing>Flow_D31_D33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D32" name="Черновик отложен">
      <bpmn:incoming>Flow_D31_D32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="D33" name="Вызвать тестовый сервис доступов">
      <bpmn:documentation>После подтверждения создать заявку. Если она уже отправлена, запросить статус. Повтор использует тот же ключ.</bpmn:documentation>
      <bpmn:incoming>Flow_D29A_D33</bpmn:incoming>
      <bpmn:incoming>Flow_D31_D33</bpmn:incoming>
      <bpmn:incoming>Flow_D37_D33</bpmn:incoming>
      <bpmn:outgoing>Flow_D33_D34</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D34" name="Сервис вернул заявку?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D33_D34</bpmn:incoming>
      <bpmn:outgoing>Flow_D34_D35</bpmn:outgoing>
      <bpmn:outgoing>Flow_D34_D36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="D35" name="Сохранить номер и статус">
      <bpmn:incoming>Flow_D34_D35</bpmn:incoming>
      <bpmn:outgoing>Flow_D35_D40</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D36" name="Показать сбой и возможность повтора">
      <bpmn:incoming>Flow_D34_D36</bpmn:incoming>
      <bpmn:outgoing>Flow_D36_D37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D37" name="Повторить?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D36_D37</bpmn:incoming>
      <bpmn:outgoing>Flow_D37_D33</bpmn:outgoing>
      <bpmn:outgoing>Flow_D37_D38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D38" name="Повтор отложен">
      <bpmn:incoming>Flow_D37_D38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="D40" name="Статус заявки?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D35_D40</bpmn:incoming>
      <bpmn:outgoing>Flow_D40_D41</bpmn:outgoing>
      <bpmn:outgoing>Flow_D40_D42</bpmn:outgoing>
      <bpmn:outgoing>Flow_D40_D43</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="D41" name="Показать ожидание и другой шаг">
      <bpmn:incoming>Flow_D40_D41</bpmn:incoming>
      <bpmn:outgoing>Flow_D41_D44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D42" name="Показать одобрение и следующий шаг">
      <bpmn:incoming>Flow_D40_D42</bpmn:incoming>
      <bpmn:outgoing>Flow_D42_D44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D43" name="Показать отказ и контакт бадди">
      <bpmn:incoming>Flow_D40_D43</bpmn:incoming>
      <bpmn:outgoing>Flow_D43_D44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="D44" name="Статус показан">
      <bpmn:incoming>Flow_D41_D44</bpmn:incoming>
      <bpmn:incoming>Flow_D42_D44</bpmn:incoming>
      <bpmn:incoming>Flow_D43_D44</bpmn:incoming>
    </bpmn:endEvent>
