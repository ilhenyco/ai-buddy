<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Journey" targetNamespace="https://ai-buddy.example/bpmn" exporter="AI-buddy analysis">
  <bpmn:collaboration id="Collaboration_Journey">
    <bpmn:participant id="Pool_Journey" name="AI-buddy · Весь путь стажировки" processRef="Process_Journey" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Journey" name="AI-buddy · Весь путь стажировки" isExecutable="false">
    <bpmn:laneSet id="Lanes_Journey">
      <bpmn:lane id="Journey_lead" name="Руководитель">
        <bpmn:flowNodeRef>O01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O11A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O20</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Journey_intern" name="Стажёр">
        <bpmn:flowNodeRef>O10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O21</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Journey_buddy" name="Бадди">
        <bpmn:flowNodeRef>O11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Journey_ai" name="AI-buddy">
        <bpmn:flowNodeRef>O05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>O09</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="O01" name="Известен выход стажёра">
      <bpmn:outgoing>Flow_O01_O02</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="O02" name="Выбрать стажёра и дату выхода">
      <bpmn:incoming>Flow_O01_O02</bpmn:incoming>
      <bpmn:outgoing>Flow_O02_O03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O03" name="Назначить бадди">
      <bpmn:incoming>Flow_O02_O03</bpmn:incoming>
      <bpmn:outgoing>Flow_O03_O04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O04" name="Выбрать шаблон на 6 или 9 месяцев">
      <bpmn:incoming>Flow_O03_O04</bpmn:incoming>
      <bpmn:outgoing>Flow_O04_O05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="O05" name="Предложить этапы и сроки">
      <bpmn:documentation>Шаблон от даты выхода. Сроки ориентировочные.</bpmn:documentation>
      <bpmn:incoming>Flow_O04_O05</bpmn:incoming>
      <bpmn:outgoing>Flow_O05_O06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="O06" name="Настроить этапы плана">
      <bpmn:documentation>Можно добавить, убрать и переставить любой этап. Уточнить срок, результат и того, кто помогает.</bpmn:documentation>
      <bpmn:incoming>Flow_O05_O06</bpmn:incoming>
      <bpmn:incoming>Flow_O08_O06</bpmn:incoming>
      <bpmn:outgoing>Flow_O06_O07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="O07" name="Проверить план глазами стажёра">
      <bpmn:incoming>Flow_O06_O07</bpmn:incoming>
      <bpmn:outgoing>Flow_O07_O08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="O08" name="План готов?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_O07_O08</bpmn:incoming>
      <bpmn:outgoing>Flow_O08_O06</bpmn:outgoing>
      <bpmn:outgoing>Flow_O08_O09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="O09" name="Опубликовать план и назначение">
      <bpmn:documentation>Опубликованный план становится входом для первого входа стажёра.</bpmn:documentation>
      <bpmn:incoming>Flow_O08_O09</bpmn:incoming>
      <bpmn:outgoing>Flow_O09_O10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="O10" name="Открыть AI-buddy и увидеть первый шаг">
      <bpmn:incoming>Flow_O09_O10</bpmn:incoming>
      <bpmn:outgoing>Flow_O10_O11A</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="O11A" name="Согласовать цели и критерии успеха">
      <bpmn:incoming>Flow_O10_O11A</bpmn:incoming>
      <bpmn:outgoing>Flow_O11A_O11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O11" name="Познакомить с командой и помочь с задачами">
      <bpmn:incoming>Flow_O11A_O11</bpmn:incoming>
      <bpmn:outgoing>Flow_O11_O12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O12" name="Пройти адаптацию и начать работу">
      <bpmn:documentation>Детализация первого входа и трёх сценариев в onboarding.bpmn.</bpmn:documentation>
      <bpmn:incoming>Flow_O11_O12</bpmn:incoming>
      <bpmn:outgoing>Flow_O12_O13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O13" name="Собрать результаты к экватору">
      <bpmn:incoming>Flow_O12_O13</bpmn:incoming>
      <bpmn:outgoing>Flow_O13_O14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O14" name="Обсудить прогресс и приоритеты">
      <bpmn:documentation>Срок из опубликованного плана. Для предложенного шаблона конец 3-го месяца или середина 5-го.</bpmn:documentation>
      <bpmn:incoming>Flow_O13_O14</bpmn:incoming>
      <bpmn:outgoing>Flow_O14_O15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O15" name="Разложить оставшиеся цели на задачи">
      <bpmn:incoming>Flow_O14_O15</bpmn:incoming>
      <bpmn:outgoing>Flow_O15_O16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O16" name="Продолжить работу по обновлённому плану">
      <bpmn:incoming>Flow_O15_O16</bpmn:incoming>
      <bpmn:outgoing>Flow_O16_O17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O17" name="Объяснить формат финала и сроки решения">
      <bpmn:documentation>Ориентир за месяц до конца. Порядок обсуждения продолжения работы предложен командой.</bpmn:documentation>
      <bpmn:incoming>Flow_O16_O17</bpmn:incoming>
      <bpmn:outgoing>Flow_O17_O18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O18" name="Помочь подготовить итоговое выступление">
      <bpmn:incoming>Flow_O17_O18</bpmn:incoming>
      <bpmn:outgoing>Flow_O18_O19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O19" name="Представить результаты и передать задачи">
      <bpmn:incoming>Flow_O18_O19</bpmn:incoming>
      <bpmn:outgoing>Flow_O19_O20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O20" name="Обсудить итог и дальнейшие шаги">
      <bpmn:documentation>Если решение на согласовании, назвать ответственного и срок ответа.</bpmn:documentation>
      <bpmn:incoming>Flow_O19_O20</bpmn:incoming>
      <bpmn:outgoing>Flow_O20_O21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="O21" name="Итоги и следующий шаг известны">
      <bpmn:incoming>Flow_O20_O21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_O01_O02" sourceRef="O01" targetRef="O02" />
    <bpmn:sequenceFlow id="Flow_O02_O03" sourceRef="O02" targetRef="O03" />
    <bpmn:sequenceFlow id="Flow_O03_O04" sourceRef="O03" targetRef="O04" />
    <bpmn:sequenceFlow id="Flow_O04_O05" sourceRef="O04" targetRef="O05" />
    <bpmn:sequenceFlow id="Flow_O05_O06" sourceRef="O05" targetRef="O06" />
    <bpmn:sequenceFlow id="Flow_O06_O07" sourceRef="O06" targetRef="O07" />
    <bpmn:sequenceFlow id="Flow_O07_O08" sourceRef="O07" targetRef="O08" />
    <bpmn:sequenceFlow id="Flow_O08_O06" sourceRef="O08" targetRef="O06" name="Уточнить" />
    <bpmn:sequenceFlow id="Flow_O08_O09" sourceRef="O08" targetRef="O09" name="Опубликовать" />
    <bpmn:sequenceFlow id="Flow_O09_O10" sourceRef="O09" targetRef="O10" />
    <bpmn:sequenceFlow id="Flow_O10_O11A" sourceRef="O10" targetRef="O11A" />
    <bpmn:sequenceFlow id="Flow_O11A_O11" sourceRef="O11A" targetRef="O11" />
    <bpmn:sequenceFlow id="Flow_O11_O12" sourceRef="O11" targetRef="O12" />
    <bpmn:sequenceFlow id="Flow_O12_O13" sourceRef="O12" targetRef="O13" />
    <bpmn:sequenceFlow id="Flow_O13_O14" sourceRef="O13" targetRef="O14" />
    <bpmn:sequenceFlow id="Flow_O14_O15" sourceRef="O14" targetRef="O15" />
    <bpmn:sequenceFlow id="Flow_O15_O16" sourceRef="O15" targetRef="O16" />
    <bpmn:sequenceFlow id="Flow_O16_O17" sourceRef="O16" targetRef="O17" />
    <bpmn:sequenceFlow id="Flow_O17_O18" sourceRef="O17" targetRef="O18" />
    <bpmn:sequenceFlow id="Flow_O18_O19" sourceRef="O18" targetRef="O19" />
    <bpmn:sequenceFlow id="Flow_O19_O20" sourceRef="O19" targetRef="O20" />
    <bpmn:sequenceFlow id="Flow_O20_O21" sourceRef="O20" targetRef="O21" />
    <bpmn:textAnnotation id="Note_Overview_Scope">
      <bpmn:text>Настройка руководителем описана на карте. В прототипе используется готовый опубликованный план.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Overview_Adaptation">
      <bpmn:text>Подробный процесс первых дней — в onboarding.bpmn.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Overview_Milestones">
      <bpmn:text>Экватор и финал показаны как этапы полного пути. Их сроки задаёт план стажировки.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
