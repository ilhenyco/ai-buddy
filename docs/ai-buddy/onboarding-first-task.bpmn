<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FirstTask" targetNamespace="https://ai-buddy.example/bpmn" exporter="AI-buddy analysis">
  <bpmn:collaboration id="Collaboration_FirstTask">
    <bpmn:participant id="Pool_FirstTask" name="04 · Подготовка к первой задаче" processRef="Process_FirstTask" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FirstTask" name="04 · Подготовка к первой задаче" isExecutable="false">
    <bpmn:laneSet id="Lanes_FirstTask">
      <bpmn:lane id="FirstTask_intern" name="Стажёр">
        <bpmn:flowNodeRef>D45</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D49</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D50</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D51</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D53</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D54</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D59</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FirstTask_ai" name="AI-buddy">
        <bpmn:flowNodeRef>D46</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D47</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D52</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D55</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D56</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="FirstTask_buddy" name="Бадди">
        <bpmn:flowNodeRef>D57</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>D58</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="D45" name="Открыта первая задача">
      <bpmn:outgoing>Flow_D45_D46</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="D46" name="Проверить необходимые доступы">
      <bpmn:incoming>Flow_D45_D46</bpmn:incoming>
      <bpmn:outgoing>Flow_D46_D47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D47" name="Доступ одобрен?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D46_D47</bpmn:incoming>
      <bpmn:outgoing>Flow_D47_D52</bpmn:outgoing>
      <bpmn:outgoing>Flow_D47_D48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="D52" name="Показать задачу, критерии и материалы">
      <bpmn:incoming>Flow_D47_D52</bpmn:incoming>
      <bpmn:outgoing>Flow_D52_D53</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="D48" name="Показать блокер и переход к заявке">
      <bpmn:incoming>Flow_D47_D48</bpmn:incoming>
      <bpmn:outgoing>Flow_D48_D49</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="D49" name="К доступам?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D48_D49</bpmn:incoming>
      <bpmn:outgoing>Flow_D49_D50</bpmn:outgoing>
      <bpmn:outgoing>Flow_D49_D51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D50" name="Переход в «Доступы»">
      <bpmn:incoming>Flow_D49_D50</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="D51" name="Возврат в «Мой старт»">
      <bpmn:incoming>Flow_D49_D51</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="D53" name="Что дальше?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_D52_D53</bpmn:incoming>
      <bpmn:outgoing>Flow_D53_D54</bpmn:outgoing>
      <bpmn:outgoing>Flow_D53_D57</bpmn:outgoing>
      <bpmn:outgoing>Flow_D53_D59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="D54" name="Отметить готовность начать">
      <bpmn:incoming>Flow_D53_D54</bpmn:incoming>
      <bpmn:outgoing>Flow_D54_D55</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="D55" name="Сохранить готовность">
      <bpmn:incoming>Flow_D54_D55</bpmn:incoming>
      <bpmn:outgoing>Flow_D55_D56</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="D56" name="Готовность сохранена">
      <bpmn:incoming>Flow_D55_D56</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="D57" name="Уточнить требования вне AI-buddy">
      <bpmn:incoming>Flow_D53_D57</bpmn:incoming>
      <bpmn:outgoing>Flow_D57_D58</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="D58" name="Вопрос передан бадди">
      <bpmn:incoming>Flow_D57_D58</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="D59" name="Задача отложена">
      <bpmn:incoming>Flow_D53_D59</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_D45_D46" sourceRef="D45" targetRef="D46" />
    <bpmn:sequenceFlow id="Flow_D46_D47" sourceRef="D46" targetRef="D47" />
    <bpmn:sequenceFlow id="Flow_D47_D52" sourceRef="D47" targetRef="D52" name="Да" />
