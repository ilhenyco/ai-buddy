      <bpmn:incoming>Flow_D31_D33</bpmn:incoming>
      <bpmn:incoming>Flow_D37_D33</bpmn:incoming>
      <bpmn:outgoing>Flow_D33_D34</bpmn:outgoing>
    </bpmn:serviceTask>
