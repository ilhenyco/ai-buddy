# Copy to .env for local runs. Never commit real secrets.
HTTP_ADDR=:8080
DATABASE_URL=postgres://homych:homych@localhost:55432/homych?sslmode=disable
# demo login + synthetic seed; false requires SESSION_SECRET
DEMO_MODE=true
SESSION_SECRET=
APP_TZ=Europe/Moscow
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
SECURE_COOKIE=false
# access request service; empty switches access requests off (cmd/mock-access in the demo)
ACCESS_SERVICE_URL=http://localhost:8091
# for tests: admin connection, each test package creates its own database
TEST_DATABASE_URL=postgres://homych:homych@localhost:55432/postgres?sslmode=disable
# Optional Python RAG integration (knowledge/). Same dedicated token in Go and Python; disabled if empty.
# RAG_SERVICE_TOKEN=replace-with-a-random-token-at-least-24-characters
# answers: where the knowledge service is; the wait must exceed its RAG_REQUEST_TIMEOUT
# RAG_URL=http://localhost:8090
# RAG_CLIENT_TIMEOUT=270s
# sources: a client key with the documents:write scope (its SHA-256 goes to RAG_EXTERNAL_CLIENTS of the service)
# RAG_SOURCES_TOKEN=
