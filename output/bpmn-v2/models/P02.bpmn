      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_e_di" bpmnElement="P02_e" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1518" y="84" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="1470" y="126" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_session_di" bpmnElement="P02_session" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="423" y="258" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_signed_di" bpmnElement="P02_signed" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="642" y="282" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="588" y="336" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_err_di" bpmnElement="P02_err" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="771" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_load_di" bpmnElement="P02_load" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="771" y="318" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_has_di" bpmnElement="P02_has" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="990" y="282" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="936" y="336" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_contact_di" bpmnElement="P02_contact" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1119" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_home_di" bpmnElement="P02_home" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1119" y="318" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_blocked_di" bpmnElement="P02_blocked" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1344" y="288" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="1296" y="330" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P02_F01_di" bpmnElement="P02_F01">
        <di:waypoint x="162" y="102"/>
        <di:waypoint x="249" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F02_di" bpmnElement="P02_F02">
        <di:waypoint x="387" y="102"/>
        <di:waypoint x="396" y="102"/>
        <di:waypoint x="396" y="306"/>
        <di:waypoint x="423" y="306"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F03_di" bpmnElement="P02_F03">
        <di:waypoint x="561" y="306"/>
        <di:waypoint x="642" y="306"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F04_di" bpmnElement="P02_F04">
        <di:waypoint x="690" y="306"/>
        <di:waypoint x="756" y="306"/>
        <di:waypoint x="756" y="366"/>
        <di:waypoint x="771" y="366"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="726" y="281" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F05_di" bpmnElement="P02_F05">
        <di:waypoint x="690" y="306"/>
        <di:waypoint x="702" y="306"/>
        <di:waypoint x="702" y="246"/>
        <di:waypoint x="771" y="246"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="720" y="221" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F06_di" bpmnElement="P02_F06">
        <di:waypoint x="840" y="198"/>
        <di:waypoint x="840" y="162"/>
        <di:waypoint x="318" y="162"/>
        <di:waypoint x="318" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F07_di" bpmnElement="P02_F07">
        <di:waypoint x="909" y="366"/>
        <di:waypoint x="918" y="366"/>
        <di:waypoint x="918" y="306"/>
        <di:waypoint x="990" y="306"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F08_di" bpmnElement="P02_F08">
        <di:waypoint x="1038" y="306"/>
        <di:waypoint x="1104" y="306"/>
        <di:waypoint x="1104" y="366"/>
        <di:waypoint x="1119" y="366"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="1074" y="281" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F09_di" bpmnElement="P02_F09">
        <di:waypoint x="1038" y="306"/>
        <di:waypoint x="1050" y="306"/>
        <di:waypoint x="1050" y="246"/>
        <di:waypoint x="1119" y="246"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="1068" y="221" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F10_di" bpmnElement="P02_F10">
        <di:waypoint x="1257" y="246"/>
        <di:waypoint x="1266" y="246"/>
        <di:waypoint x="1266" y="306"/>
        <di:waypoint x="1344" y="306"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F11_di" bpmnElement="P02_F11">
        <di:waypoint x="1257" y="366"/>
        <di:waypoint x="1278" y="366"/>
        <di:waypoint x="1278" y="102"/>
        <di:waypoint x="1293" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P02_F12_di" bpmnElement="P02_F12">
        <di:waypoint x="1431" y="102"/>
        <di:waypoint x="1518" y="102"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="P02_font">
      <dc:Font name="Arial" size="13"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
