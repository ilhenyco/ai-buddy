<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P02" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P02_collab">
    <bpmn:participant id="P02_pool" name="Первый вход и следующий шаг" processRef="P02_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P02_process" name="Первый вход и следующий шаг" isExecutable="false">
    <bpmn:documentation>Область: Прототип
Старт: Стажёр открывает экран входа
Результат: Показан свой план и вход в нужную карточку либо указан контакт руководителя.
Приёмка: Два тестовых пользователя видят разные планы. Ошибка входа возвращает 401. При отсутствии опубликованного плана карточки закрыты, виден контакт руководителя.
POST /demo/session, затем GET /onboarding. Контакт руководителя берётся из профиля, доступного по сессии.
Выбор карточки открывает P03, P04 или P07. Чат открывает P14. Пользователь может вернуться в P02 без потери прогресса.</bpmn:documentation>
    <bpmn:laneSet id="P02_lanes">
      <bpmn:lane id="P02_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P02_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_has</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_blocked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_s" name="Первый вход">
      <bpmn:outgoing>P02_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P02_login" name="Войти под тестовым аккаунтом">
      <bpmn:documentation>Лист 3, строка 8. Первый вход
Роль: Стажёр
Результат: Стажёр увидел свой план или передал руководителю вопрос.
Участие AI-buddy: Прототип. Показывает план и ближайший шаг. Если плана нет, указывает контакт руководителя.</bpmn:documentation>
      <bpmn:incoming>P02_F01</bpmn:incoming>
      <bpmn:incoming>P02_F06</bpmn:incoming>
      <bpmn:outgoing>P02_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P02_session" name="Проверить данные входа">
      <bpmn:incoming>P02_F02</bpmn:incoming>
      <bpmn:outgoing>P02_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_signed" name="Сессия создана?" default="P02_F05" gatewayDirection="Diverging">
      <bpmn:incoming>P02_F03</bpmn:incoming>
      <bpmn:outgoing>P02_F04</bpmn:outgoing>
      <bpmn:outgoing>P02_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_err" name="Показать ошибку входа">
      <bpmn:incoming>P02_F05</bpmn:incoming>
      <bpmn:outgoing>P02_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_load" name="Загрузить свой опубликованный план">
      <bpmn:incoming>P02_F04</bpmn:incoming>
      <bpmn:outgoing>P02_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_has" name="План доступен?" default="P02_F09" gatewayDirection="Diverging">
      <bpmn:incoming>P02_F07</bpmn:incoming>
      <bpmn:outgoing>P02_F08</bpmn:outgoing>
      <bpmn:outgoing>P02_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_contact" name="Показать контакт руководителя">
      <bpmn:incoming>P02_F09</bpmn:incoming>
      <bpmn:outgoing>P02_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_home" name="Показать «Мой старт» и три карточки">
      <bpmn:documentation>Лист 3, строка 9. Карточка «Мой старт»
Роль: AI-buddy
Результат: Стажёр понимает, с чего начать и к кому обратиться.
Участие AI-buddy: Прототип. Показывает доступные стажёру этап, контакты и следующий шаг.</bpmn:documentation>
      <bpmn:incoming>P02_F08</bpmn:incoming>
      <bpmn:outgoing>P02_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P02_choose" name="Выбрать карточку или чат">
      <bpmn:incoming>P02_F11</bpmn:incoming>
      <bpmn:outgoing>P02_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P02_e" name="Открыт сценарий">
      <bpmn:incoming>P02_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P02_blocked" name="План недоступен">
      <bpmn:incoming>P02_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_F01" sourceRef="P02_s" targetRef="P02_login"/>
    <bpmn:sequenceFlow id="P02_F02" sourceRef="P02_login" targetRef="P02_session"/>
    <bpmn:sequenceFlow id="P02_F03" sourceRef="P02_session" targetRef="P02_signed"/>
    <bpmn:sequenceFlow id="P02_F04" sourceRef="P02_signed" targetRef="P02_load" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sessionCreated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F05" sourceRef="P02_signed" targetRef="P02_err" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F06" sourceRef="P02_err" targetRef="P02_login"/>
    <bpmn:sequenceFlow id="P02_F07" sourceRef="P02_load" targetRef="P02_has"/>
    <bpmn:sequenceFlow id="P02_F08" sourceRef="P02_has" targetRef="P02_home" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">publishedPlanVisible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F09" sourceRef="P02_has" targetRef="P02_contact" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F10" sourceRef="P02_contact" targetRef="P02_blocked"/>
    <bpmn:sequenceFlow id="P02_F11" sourceRef="P02_home" targetRef="P02_choose"/>
    <bpmn:sequenceFlow id="P02_F12" sourceRef="P02_choose" targetRef="P02_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P02_diagram" name="Первый вход и следующий шаг">
    <bpmndi:BPMNPlane id="P02_plane" bpmnElement="P02_collab">
      <bpmndi:BPMNShape id="P02_pool_di" bpmnElement="P02_pool" isHorizontal="true">
        <dc:Bounds x="30" y="36" width="1674" height="408"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_lane_I_di" bpmnElement="P02_lane_I" isHorizontal="true">
        <dc:Bounds x="60" y="36" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_lane_A_di" bpmnElement="P02_lane_A" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="1644" height="264"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_s_di" bpmnElement="P02_s" bioc:fill="#E1F5E6" bioc:stroke="#243448">
        <dc:Bounds x="126" y="84" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P02_font">
          <dc:Bounds x="78" y="126" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P02_login_di" bpmnElement="P02_login" bioc:fill="#E7F1FF" bioc:stroke="#243448">
