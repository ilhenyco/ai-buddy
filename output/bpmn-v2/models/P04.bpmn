<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P04" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P04_collab">
    <bpmn:participant id="P04_pool" name="Подготовка заявки на доступ" processRef="P04_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P04_process" name="Подготовка заявки на доступ" isExecutable="false">
    <bpmn:documentation>Область: Прототип и поддержка бадди
Старт: Стажёр открыл «Доступы» и выбрал ресурс
Результат: Показан черновик с точным обоснованием, существующая попытка или отказ в доступе к ресурсу.
Приёмка: Чужой ресурс не раскрывается. Черновик не вызывает сервис. Редактирование сохраняет новый черновик с параметрами, которые видит и подтверждает стажёр.
Пояснение бадди проходит вне интерфейса. При необходимости стажёр уточняет ресурс до подготовки черновика.
POST /access-drafts создаёт черновик после валидации. При отсутствии подсказки стажёр вводит обоснование сам. Если попытка уже есть, показывается состояние. Для submitting доступен повтор в P05, для известного статуса — P06.</bpmn:documentation>
    <bpmn:laneSet id="P04_lanes">
      <bpmn:lane id="P04_lane_B" name="Бадди">
        <bpmn:flowNodeRef>P04_guide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P04_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_help</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P04_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_prev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_M" name="Модель AI">
        <bpmn:flowNodeRef>P04_suggest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_s" name="Открыты «Доступы»">
      <bpmn:outgoing>P04_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P04_pick" name="Выбрать ресурс">
      <bpmn:documentation>Лист 3, строка 16. Заявка на доступ
Роль: Стажёр
Результат: В плане видны номер и статус заявки либо причина, почему её не удалось отправить.
Участие AI-buddy: Прототип. Готовит черновик. После подтверждения стажёра отправляет через сервис и показывает статус.</bpmn:documentation>
      <bpmn:incoming>P04_F01</bpmn:incoming>
      <bpmn:outgoing>P04_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P04_help" name="Нужна подсказка бадди?" default="P04_F04" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F02</bpmn:incoming>
      <bpmn:outgoing>P04_F03</bpmn:outgoing>
      <bpmn:outgoing>P04_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P04_guide" name="Пояснить нужные доступы">
      <bpmn:documentation>Лист 3, строка 15. Доступы и инструменты
Роль: Бадди
Результат: Стажёр знает, какие доступы запросить и к кому идти с блокером.
Участие AI-buddy: Прототип. Показывает статус и контакт бадди, если заявка отклонена.</bpmn:documentation>
      <bpmn:incoming>P04_F03</bpmn:incoming>
      <bpmn:outgoing>P04_F05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="P04_auth" name="Проверить ресурс и найти попытку">
      <bpmn:incoming>P04_F04</bpmn:incoming>
      <bpmn:incoming>P04_F05</bpmn:incoming>
      <bpmn:outgoing>P04_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_ok" name="Ресурс разрешён?" default="P04_F08" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F06</bpmn:incoming>
      <bpmn:outgoing>P04_F07</bpmn:outgoing>
      <bpmn:outgoing>P04_F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_fail" name="Ресурс недоступен">
      <bpmn:incoming>P04_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P04_exists" name="Попытка есть?" default="P04_F10" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F07</bpmn:incoming>
      <bpmn:outgoing>P04_F09</bpmn:outgoing>
      <bpmn:outgoing>P04_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_prev" name="Состояние сохранённой попытки">
      <bpmn:incoming>P04_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P04_suggest" name="Предложить обоснование">
      <bpmn:documentation>Лист 3, строка 17. Черновик и статус заявки
Роль: AI-buddy
Результат: Сохранены номер и статус либо показан понятный способ повтора.
Участие AI-buddy: Прототип. Предлагает обоснование и показывает ответ сервиса. При сбое даёт повторить без дубликата.</bpmn:documentation>
      <bpmn:incoming>P04_F10</bpmn:incoming>
      <bpmn:outgoing>P04_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_edit" name="Проверить или изменить обоснование">
      <bpmn:incoming>P04_F11</bpmn:incoming>
      <bpmn:outgoing>P04_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_save" name="Сохранить и показать точный черновик">
      <bpmn:incoming>P04_F12</bpmn:incoming>
      <bpmn:outgoing>P04_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P04_e" name="Черновик к подтверждению">
      <bpmn:incoming>P04_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_F01" sourceRef="P04_s" targetRef="P04_pick"/>
    <bpmn:sequenceFlow id="P04_F02" sourceRef="P04_pick" targetRef="P04_help"/>
    <bpmn:sequenceFlow id="P04_F03" sourceRef="P04_help" targetRef="P04_guide" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">buddyHelpRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F04" sourceRef="P04_help" targetRef="P04_auth" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F05" sourceRef="P04_guide" targetRef="P04_auth"/>
    <bpmn:sequenceFlow id="P04_F06" sourceRef="P04_auth" targetRef="P04_ok"/>
    <bpmn:sequenceFlow id="P04_F07" sourceRef="P04_ok" targetRef="P04_exists" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resourceAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F08" sourceRef="P04_ok" targetRef="P04_fail" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F09" sourceRef="P04_exists" targetRef="P04_prev" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attemptExists</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F10" sourceRef="P04_exists" targetRef="P04_suggest" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F11" sourceRef="P04_suggest" targetRef="P04_edit"/>
    <bpmn:sequenceFlow id="P04_F12" sourceRef="P04_edit" targetRef="P04_save"/>
    <bpmn:sequenceFlow id="P04_F13" sourceRef="P04_save" targetRef="P04_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P04_diagram" name="Подготовка заявки на доступ">
    <bpmndi:BPMNPlane id="P04_plane" bpmnElement="P04_collab">
      <bpmndi:BPMNShape id="P04_pool_di" bpmnElement="P04_pool" isHorizontal="true">
        <dc:Bounds x="30" y="36" width="2022" height="696"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_lane_B_di" bpmnElement="P04_lane_B" isHorizontal="true">
        <dc:Bounds x="60" y="36" width="1992" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_lane_I_di" bpmnElement="P04_lane_I" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="1992" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_lane_A_di" bpmnElement="P04_lane_A" isHorizontal="true">
        <dc:Bounds x="60" y="324" width="1992" height="264"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_lane_M_di" bpmnElement="P04_lane_M" isHorizontal="true">
        <dc:Bounds x="60" y="588" width="1992" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_guide_di" bpmnElement="P04_guide" bioc:fill="#E7F5F0" bioc:stroke="#243448">
