      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_e_di" bpmnElement="P04_e" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1866" y="228" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1818" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_auth_di" bpmnElement="P04_auth" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="771" y="402" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_ok_di" bpmnElement="P04_ok" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="990" y="426" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="936" y="480" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_fail_di" bpmnElement="P04_fail" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1170" y="372" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1122" y="414" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_exists_di" bpmnElement="P04_exists" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="1164" y="486" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1110" y="540" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_prev_di" bpmnElement="P04_prev" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1344" y="432" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1296" y="474" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_save_di" bpmnElement="P04_save" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1641" y="402" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_suggest_di" bpmnElement="P04_suggest" bioc:fill="#EDE8FF" bioc:stroke="#243448">
        <dc:Bounds x="1293" y="606" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P04_F01_di" bpmnElement="P04_F01">
        <di:waypoint x="162" y="246"/>
        <di:waypoint x="249" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F02_di" bpmnElement="P04_F02">
        <di:waypoint x="387" y="246"/>
        <di:waypoint x="468" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F03_di" bpmnElement="P04_F03">
        <di:waypoint x="516" y="246"/>
        <di:waypoint x="528" y="246"/>
        <di:waypoint x="528" y="102"/>
        <di:waypoint x="597" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="547" y="77" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F04_di" bpmnElement="P04_F04">
        <di:waypoint x="516" y="246"/>
        <di:waypoint x="756" y="246"/>
        <di:waypoint x="756" y="450"/>
        <di:waypoint x="771" y="450"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="620" y="221" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F05_di" bpmnElement="P04_F05">
        <di:waypoint x="735" y="102"/>
        <di:waypoint x="744" y="102"/>
        <di:waypoint x="744" y="450"/>
        <di:waypoint x="771" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F06_di" bpmnElement="P04_F06">
        <di:waypoint x="909" y="450"/>
        <di:waypoint x="990" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F07_di" bpmnElement="P04_F07">
        <di:waypoint x="1038" y="450"/>
        <di:waypoint x="1110" y="450"/>
        <di:waypoint x="1110" y="510"/>
        <di:waypoint x="1164" y="510"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1059" y="425" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F08_di" bpmnElement="P04_F08">
        <di:waypoint x="1038" y="450"/>
