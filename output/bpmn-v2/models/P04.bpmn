        <di:waypoint x="1050" y="390"/>
        <di:waypoint x="1170" y="390"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1094" y="365" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F09_di" bpmnElement="P04_F09">
        <di:waypoint x="1212" y="510"/>
        <di:waypoint x="1284" y="510"/>
        <di:waypoint x="1284" y="450"/>
        <di:waypoint x="1344" y="450"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1233" y="485" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F10_di" bpmnElement="P04_F10">
        <di:waypoint x="1212" y="510"/>
        <di:waypoint x="1224" y="510"/>
        <di:waypoint x="1224" y="528"/>
        <di:waypoint x="1278" y="528"/>
        <di:waypoint x="1278" y="654"/>
        <di:waypoint x="1293" y="654"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="1286" y="550" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F11_di" bpmnElement="P04_F11">
        <di:waypoint x="1431" y="654"/>
        <di:waypoint x="1440" y="654"/>
        <di:waypoint x="1440" y="246"/>
        <di:waypoint x="1467" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F12_di" bpmnElement="P04_F12">
        <di:waypoint x="1605" y="246"/>
