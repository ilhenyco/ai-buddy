        <di:waypoint x="1614" y="450"/>
        <di:waypoint x="1641" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P04_F13_di" bpmnElement="P04_F13">
        <di:waypoint x="1779" y="450"/>
