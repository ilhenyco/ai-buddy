        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="78" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_pick_di" bpmnElement="P04_pick" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="249" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_help_di" bpmnElement="P04_help" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="468" y="222" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P04_font">
          <dc:Bounds x="414" y="276" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P04_edit_di" bpmnElement="P04_edit" bioc:fill="#E7F1FF" bioc:stroke="#243448">
