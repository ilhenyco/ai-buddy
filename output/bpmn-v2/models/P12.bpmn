<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P12" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P12_collab">
    <bpmn:participant id="P12_pool" name="Итог и передача задач" processRef="P12_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P12_process" name="Итог и передача задач" isExecutable="false">
    <bpmn:documentation>Область: Полная карта процесса вне AI-buddy
Старт: Наступила итоговая встреча
Результат: Команда приняла задачи. Стажёру сообщён итог или дата следующего ответа.
Приёмка: Оценка, сообщение решения и проверка передачи принадлежат людям. При ожидании фиксируется ответственный и срок следующего ответа.
Модель не выставляет оценку и не принимает решение о переходе. Оба исхода передают в P13 только статус, зафиксированный ответственным.</bpmn:documentation>
    <bpmn:laneSet id="P12_lanes">
      <bpmn:lane id="P12_lane_L" name="Руководитель">
        <bpmn:flowNodeRef>P12_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_w</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_lane_B" name="Бадди">
        <bpmn:flowNodeRef>P12_handoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P12_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P12_s" name="Последняя неделя">
      <bpmn:outgoing>P12_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P12_result" name="Представить результат и передать задачи">
      <bpmn:documentation>Лист 3, строка 36. Итоговое выступление и передача задач
Роль: Стажёр
Результат: Результаты представлены. Для открытых задач назначены получатели.
Участие AI-buddy: Не участвует. Стажёр представляет результаты и передаёт задачи команде.</bpmn:documentation>
      <bpmn:incoming>P12_F01</bpmn:incoming>
      <bpmn:outgoing>P12_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P12_handoff" name="Проверить приём задач командой">
      <bpmn:documentation>Лист 3, строка 37. Передача контекста
Роль: Бадди
Результат: Команда знает статус открытых задач и где искать материалы.
Участие AI-buddy: Не участвует. Бадди проверяет ссылки и приём задач командой.</bpmn:documentation>
      <bpmn:incoming>P12_F02</bpmn:incoming>
      <bpmn:outgoing>P12_F03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P12_review" name="Обсудить итоговую оценку">
      <bpmn:documentation>Лист 3, строка 38. Итоговая оценка и дальнейший шаг
Роль: Руководитель
Результат: Зафиксированы итог, следующий шаг и срок ответа, если решение ещё согласуется.
Участие AI-buddy: Не участвует в оценке и решении. Их сообщает руководитель.</bpmn:documentation>
      <bpmn:incoming>P12_F03</bpmn:incoming>
      <bpmn:outgoing>P12_F04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P12_g" name="Решение согласовано?" default="P12_F06" gatewayDirection="Diverging">
      <bpmn:incoming>P12_F04</bpmn:incoming>
      <bpmn:outgoing>P12_F05</bpmn:outgoing>
      <bpmn:outgoing>P12_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P12_yes" name="Сообщить согласованный итог">
      <bpmn:documentation>Лист 3, строка 38. Итоговая оценка и дальнейший шаг
Роль: Руководитель
Результат: Зафиксированы итог, следующий шаг и срок ответа, если решение ещё согласуется.
Участие AI-buddy: Не участвует в оценке и решении. Их сообщает руководитель.</bpmn:documentation>
      <bpmn:incoming>P12_F05</bpmn:incoming>
      <bpmn:outgoing>P12_F07</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P12_wait" name="Назвать срок следующего ответа">
      <bpmn:documentation>Лист 3, строка 38. Итоговая оценка и дальнейший шаг
Роль: Руководитель
Результат: Зафиксированы итог, следующий шаг и срок ответа, если решение ещё согласуется.
Участие AI-buddy: Не участвует в оценке и решении. Их сообщает руководитель.</bpmn:documentation>
      <bpmn:incoming>P12_F06</bpmn:incoming>
      <bpmn:outgoing>P12_F08</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P12_e" name="Итог зафиксирован">
      <bpmn:incoming>P12_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P12_w" name="Ожидается решение">
      <bpmn:incoming>P12_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P12_F01" sourceRef="P12_s" targetRef="P12_result"/>
    <bpmn:sequenceFlow id="P12_F02" sourceRef="P12_result" targetRef="P12_handoff"/>
    <bpmn:sequenceFlow id="P12_F03" sourceRef="P12_handoff" targetRef="P12_review"/>
    <bpmn:sequenceFlow id="P12_F04" sourceRef="P12_review" targetRef="P12_g"/>
    <bpmn:sequenceFlow id="P12_F05" sourceRef="P12_g" targetRef="P12_yes" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decisionConfirmed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P12_F06" sourceRef="P12_g" targetRef="P12_wait" name="Нет"/>
    <bpmn:sequenceFlow id="P12_F07" sourceRef="P12_yes" targetRef="P12_e"/>
    <bpmn:sequenceFlow id="P12_F08" sourceRef="P12_wait" targetRef="P12_w"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P12_diagram" name="Итог и передача задач">
    <bpmndi:BPMNPlane id="P12_plane" bpmnElement="P12_collab">
      <bpmndi:BPMNShape id="P12_pool_di" bpmnElement="P12_pool" isHorizontal="true">
        <dc:Bounds x="30" y="36" width="1326" height="552"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_L_di" bpmnElement="P12_lane_L" isHorizontal="true">
        <dc:Bounds x="60" y="36" width="1296" height="264"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_B_di" bpmnElement="P12_lane_B" isHorizontal="true">
        <dc:Bounds x="60" y="300" width="1296" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_lane_I_di" bpmnElement="P12_lane_I" isHorizontal="true">
        <dc:Bounds x="60" y="444" width="1296" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_review_di" bpmnElement="P12_review" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="597" y="114" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_g_di" bpmnElement="P12_g" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="816" y="138" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="762" y="192" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_yes_di" bpmnElement="P12_yes" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="945" y="54" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_wait_di" bpmnElement="P12_wait" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="945" y="174" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_e_di" bpmnElement="P12_e" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1170" y="84" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="1122" y="126" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_w_di" bpmnElement="P12_w" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1170" y="204" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="1122" y="246" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_handoff_di" bpmnElement="P12_handoff" bioc:fill="#E7F5F0" bioc:stroke="#243448">
        <dc:Bounds x="423" y="318" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_s_di" bpmnElement="P12_s" bioc:fill="#E1F5E6" bioc:stroke="#243448">
        <dc:Bounds x="126" y="492" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="78" y="534" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_result_di" bpmnElement="P12_result" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="249" y="462" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P12_F01_di" bpmnElement="P12_F01">
        <di:waypoint x="162" y="510"/>
        <di:waypoint x="249" y="510"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F02_di" bpmnElement="P12_F02">
        <di:waypoint x="387" y="510"/>
        <di:waypoint x="396" y="510"/>
        <di:waypoint x="396" y="366"/>
        <di:waypoint x="423" y="366"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F03_di" bpmnElement="P12_F03">
        <di:waypoint x="561" y="366"/>
        <di:waypoint x="570" y="366"/>
        <di:waypoint x="570" y="162"/>
        <di:waypoint x="597" y="162"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F04_di" bpmnElement="P12_F04">
        <di:waypoint x="735" y="162"/>
        <di:waypoint x="816" y="162"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F05_di" bpmnElement="P12_F05">
        <di:waypoint x="864" y="162"/>
        <di:waypoint x="876" y="162"/>
        <di:waypoint x="876" y="102"/>
        <di:waypoint x="945" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="895" y="77" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F06_di" bpmnElement="P12_F06">
        <di:waypoint x="864" y="162"/>
        <di:waypoint x="930" y="162"/>
        <di:waypoint x="930" y="222"/>
        <di:waypoint x="945" y="222"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="898" y="137" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F07_di" bpmnElement="P12_F07">
        <di:waypoint x="1083" y="102"/>
        <di:waypoint x="1170" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F08_di" bpmnElement="P12_F08">
        <di:waypoint x="1083" y="222"/>
        <di:waypoint x="1170" y="222"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="P12_font">
      <dc:Font name="Arial" size="13"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
