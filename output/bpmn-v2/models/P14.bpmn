<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P14" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P14_collab">
    <bpmn:participant id="P14_pool" name="Ответ по разрешённым источникам" processRef="P14_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P14_process" name="Ответ по разрешённым источникам" isExecutable="false">
    <bpmn:documentation>Область: Прототип и поддержка трёх сценариев
Старт: Стажёр задал рабочий вопрос из «Моего старта» или карточки
Результат: Получен ответ с источником и разрешённым переходом либо полезная подсказка при нехватке данных.
Приёмка: Чужие выдержки не попадают в модель и ответ. Тайм-аут, недостоверный ID или отсутствие источника приводят к уточнению или контакту. Карточки доступны в ожидании.
POST /chat получает вопрос и ключ текущей карточки. Сервер выбирает выдержки и проверяет reply, sourceIds и предложенный resourceId.
Деморежим и Ollama используют один контракт. Модель предлагает текст и переход. Запись прогресса и вызов сервиса происходят в отдельных процессах по действию стажёра.</bpmn:documentation>
    <bpmn:laneSet id="P14_lanes">
      <bpmn:lane id="P14_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P14_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P14_filter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_help</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_lane_M" name="Модель AI">
        <bpmn:flowNodeRef>P14_model</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_s" name="Открыт чат">
      <bpmn:outgoing>P14_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P14_ask" name="Задать вопрос о своём шаге">
      <bpmn:documentation>Лист 3, строка 12. Знакомство и вопросы
Роль: Стажёр
Результат: Карточка знакомства отмечена. Вопросы разобраны или переданы бадди.
Участие AI-buddy: Прототип. Подсказывает, где найти каналы и бадди. Сохраняет отметку после знакомства.</bpmn:documentation>
      <bpmn:incoming>P14_F01</bpmn:incoming>
      <bpmn:outgoing>P14_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P14_filter" name="Проверить сессию и выбрать источники">
      <bpmn:incoming>P14_F02</bpmn:incoming>
      <bpmn:outgoing>P14_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P14_g" name="Есть подходящий источник?" default="P14_F05" gatewayDirection="Diverging">
      <bpmn:incoming>P14_F03</bpmn:incoming>
      <bpmn:outgoing>P14_F04</bpmn:outgoing>
      <bpmn:outgoing>P14_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_model" name="Сформировать ответ и ссылки">
      <bpmn:incoming>P14_F04</bpmn:incoming>
      <bpmn:outgoing>P14_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_validate" name="Проверить формат, источники и переход">
      <bpmn:incoming>P14_F06</bpmn:incoming>
      <bpmn:outgoing>P14_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P14_valid" name="Ответ пригоден?" default="P14_F09" gatewayDirection="Diverging">
      <bpmn:incoming>P14_F07</bpmn:incoming>
      <bpmn:outgoing>P14_F08</bpmn:outgoing>
      <bpmn:outgoing>P14_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_answer" name="Показать ответ и разрешённый переход">
      <bpmn:incoming>P14_F08</bpmn:incoming>
      <bpmn:outgoing>P14_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_help" name="Уточнить вопрос или показать контакт">
      <bpmn:incoming>P14_F05</bpmn:incoming>
      <bpmn:incoming>P14_F09</bpmn:incoming>
      <bpmn:outgoing>P14_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P14_e" name="Следующий шаг понятен">
      <bpmn:incoming>P14_F10</bpmn:incoming>
      <bpmn:incoming>P14_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_F01" sourceRef="P14_s" targetRef="P14_ask"/>
    <bpmn:sequenceFlow id="P14_F02" sourceRef="P14_ask" targetRef="P14_filter"/>
    <bpmn:sequenceFlow id="P14_F03" sourceRef="P14_filter" targetRef="P14_g"/>
    <bpmn:sequenceFlow id="P14_F04" sourceRef="P14_g" targetRef="P14_model" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allowedSourceFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P14_F05" sourceRef="P14_g" targetRef="P14_help" name="Нет"/>
    <bpmn:sequenceFlow id="P14_F06" sourceRef="P14_model" targetRef="P14_validate"/>
    <bpmn:sequenceFlow id="P14_F07" sourceRef="P14_validate" targetRef="P14_valid"/>
    <bpmn:sequenceFlow id="P14_F08" sourceRef="P14_valid" targetRef="P14_answer" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">replyValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P14_F09" sourceRef="P14_valid" targetRef="P14_help" name="Сбой или нет"/>
    <bpmn:sequenceFlow id="P14_F10" sourceRef="P14_answer" targetRef="P14_e"/>
    <bpmn:sequenceFlow id="P14_F11" sourceRef="P14_help" targetRef="P14_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P14_diagram" name="Ответ по разрешённым источникам">
    <bpmndi:BPMNPlane id="P14_plane" bpmnElement="P14_collab">
      <bpmndi:BPMNShape id="P14_pool_di" bpmnElement="P14_pool" isHorizontal="true">
        <dc:Bounds x="30" y="36" width="1674" height="552"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P14_lane_I_di" bpmnElement="P14_lane_I" isHorizontal="true">
        <dc:Bounds x="60" y="36" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P14_lane_A_di" bpmnElement="P14_lane_A" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="1644" height="264"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P14_lane_M_di" bpmnElement="P14_lane_M" isHorizontal="true">
        <dc:Bounds x="60" y="444" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P14_s_di" bpmnElement="P14_s" bioc:fill="#E1F5E6" bioc:stroke="#243448">
