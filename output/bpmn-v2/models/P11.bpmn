<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P11" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P11_collab">
    <bpmn:participant id="P11_pool" name="Подготовка финала" processRef="P11_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P11_process" name="Подготовка финала" isExecutable="false">
    <bpmn:documentation>Область: Полная версия
Старт: До конца стажировки остаётся около месяца
Результат: Стажёр знает критерии и срок ответа, собрал материалы и план передачи работы.
Приёмка: В продукте отображаются согласованные критерии и даты. Черновик выступления составляется по запросу из выбранных пользователем материалов.
HR согласует участников и порядок дальнейшего оформления. AI показывает только сведения, уже зафиксированные ответственными.</bpmn:documentation>
    <bpmn:laneSet id="P11_lanes">
      <bpmn:lane id="P11_lane_H" name="HR">
        <bpmn:flowNodeRef>P11_hr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane_L" name="Руководитель">
        <bpmn:flowNodeRef>P11_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_lead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane_B" name="Бадди">
        <bpmn:flowNodeRef>P11_buddy</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P11_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P11_show</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_lane_M" name="Модель AI">
        <bpmn:flowNodeRef>P11_ai</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P11_s" name="Месяц до завершения">
      <bpmn:outgoing>P11_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P11_lead" name="Уточнить формат и срок решения">
      <bpmn:documentation>Лист 3, строка 32. Формат финала и сроки решения
Роль: Руководитель
Результат: Стажёр знает, что показать и в какие сроки ждать ответа.
Участие AI-buddy: Полная версия. Показывает утверждённые критерии, формат и срок ответа после их фиксации.</bpmn:documentation>
      <bpmn:incoming>P11_F01</bpmn:incoming>
      <bpmn:outgoing>P11_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P11_hr" name="Сверить календарь и порядок оформления">
      <bpmn:documentation>Лист 3, строка 33. Организация финала
Роль: HR
Результат: Руководитель знает порядок согласования, стажёр — календарь финала.
Участие AI-buddy: Не участвует. Даты, участников и порядок оформления согласует HR.</bpmn:documentation>
      <bpmn:incoming>P11_F02</bpmn:incoming>
      <bpmn:outgoing>P11_F03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="P11_show" name="Показать требования и сроки">
      <bpmn:documentation>Лист 3, строка 35. Чек-лист подготовки к финалу
Роль: AI-buddy
Результат: У стажёра есть список действий до финальной встречи.
Участие AI-buddy: Полная версия. Показывает требования, сроки и открытые задачи. По запросу предлагает план выступления.</bpmn:documentation>
      <bpmn:incoming>P11_F03</bpmn:incoming>
      <bpmn:outgoing>P11_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P11_buddy" name="Помочь выбрать примеры работ">
      <bpmn:documentation>Лист 3, строка 34. Примеры работ для финала
Роль: Бадди
Результат: Стажёр собрал понятные примеры и получил обратную связь.
Участие AI-buddy: По запросу · полная версия. Помогает выстроить рассказ из примеров, выбранных стажёром и бадди.</bpmn:documentation>
      <bpmn:incoming>P11_F04</bpmn:incoming>
      <bpmn:outgoing>P11_F05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P11_g" name="Нужен черновик?" default="P11_F07" gatewayDirection="Diverging">
      <bpmn:incoming>P11_F05</bpmn:incoming>
      <bpmn:outgoing>P11_F06</bpmn:outgoing>
      <bpmn:outgoing>P11_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P11_ai" name="Предложить структуру выступления">
      <bpmn:documentation>Лист 3, строка 35. Чек-лист подготовки к финалу
Роль: AI-buddy
Результат: У стажёра есть список действий до финальной встречи.
Участие AI-buddy: Полная версия. Показывает требования, сроки и открытые задачи. По запросу предлагает план выступления.</bpmn:documentation>
      <bpmn:incoming>P11_F06</bpmn:incoming>
      <bpmn:outgoing>P11_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="P11_ready" name="Подготовить выступление и передачу">
      <bpmn:incoming>P11_F07</bpmn:incoming>
      <bpmn:incoming>P11_F08</bpmn:incoming>
      <bpmn:outgoing>P11_F09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P11_e" name="Материалы готовы">
      <bpmn:incoming>P11_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P11_F01" sourceRef="P11_s" targetRef="P11_lead"/>
    <bpmn:sequenceFlow id="P11_F02" sourceRef="P11_lead" targetRef="P11_hr"/>
    <bpmn:sequenceFlow id="P11_F03" sourceRef="P11_hr" targetRef="P11_show"/>
    <bpmn:sequenceFlow id="P11_F04" sourceRef="P11_show" targetRef="P11_buddy"/>
    <bpmn:sequenceFlow id="P11_F05" sourceRef="P11_buddy" targetRef="P11_g"/>
    <bpmn:sequenceFlow id="P11_F06" sourceRef="P11_g" targetRef="P11_ai" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outlineRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P11_F07" sourceRef="P11_g" targetRef="P11_ready" name="Нет"/>
    <bpmn:sequenceFlow id="P11_F08" sourceRef="P11_ai" targetRef="P11_ready"/>
    <bpmn:sequenceFlow id="P11_F09" sourceRef="P11_ready" targetRef="P11_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P11_diagram" name="Подготовка финала">
    <bpmndi:BPMNPlane id="P11_plane" bpmnElement="P11_collab">
      <bpmndi:BPMNShape id="P11_pool_di" bpmnElement="P11_pool" isHorizontal="true">
        <dc:Bounds x="30" y="36" width="1674" height="864"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_H_di" bpmnElement="P11_lane_H" isHorizontal="true">
        <dc:Bounds x="60" y="36" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_L_di" bpmnElement="P11_lane_L" isHorizontal="true">
        <dc:Bounds x="60" y="180" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_B_di" bpmnElement="P11_lane_B" isHorizontal="true">
        <dc:Bounds x="60" y="324" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_I_di" bpmnElement="P11_lane_I" isHorizontal="true">
        <dc:Bounds x="60" y="468" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_A_di" bpmnElement="P11_lane_A" isHorizontal="true">
        <dc:Bounds x="60" y="612" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lane_M_di" bpmnElement="P11_lane_M" isHorizontal="true">
        <dc:Bounds x="60" y="756" width="1644" height="144"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_hr_di" bpmnElement="P11_hr" bioc:fill="#FFF3DC" bioc:stroke="#243448">
        <dc:Bounds x="423" y="54" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_s_di" bpmnElement="P11_s" bioc:fill="#E1F5E6" bioc:stroke="#243448">
        <dc:Bounds x="126" y="228" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P11_font">
          <dc:Bounds x="78" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_lead_di" bpmnElement="P11_lead" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="249" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_buddy_di" bpmnElement="P11_buddy" bioc:fill="#E7F5F0" bioc:stroke="#243448">
        <dc:Bounds x="771" y="342" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_g_di" bpmnElement="P11_g" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="990" y="510" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P11_font">
          <dc:Bounds x="936" y="564" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_ready_di" bpmnElement="P11_ready" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="1293" y="486" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_e_di" bpmnElement="P11_e" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1518" y="516" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P11_font">
          <dc:Bounds x="1470" y="558" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_show_di" bpmnElement="P11_show" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="597" y="630" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_ai_di" bpmnElement="P11_ai" bioc:fill="#EDE8FF" bioc:stroke="#243448">
        <dc:Bounds x="1119" y="774" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P11_F01_di" bpmnElement="P11_F01">
        <di:waypoint x="162" y="246"/>
        <di:waypoint x="249" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F02_di" bpmnElement="P11_F02">
        <di:waypoint x="387" y="246"/>
        <di:waypoint x="396" y="246"/>
        <di:waypoint x="396" y="102"/>
        <di:waypoint x="423" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F03_di" bpmnElement="P11_F03">
        <di:waypoint x="561" y="102"/>
        <di:waypoint x="570" y="102"/>
        <di:waypoint x="570" y="678"/>
        <di:waypoint x="597" y="678"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F04_di" bpmnElement="P11_F04">
        <di:waypoint x="735" y="678"/>
        <di:waypoint x="744" y="678"/>
        <di:waypoint x="744" y="390"/>
        <di:waypoint x="771" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F05_di" bpmnElement="P11_F05">
        <di:waypoint x="909" y="390"/>
        <di:waypoint x="918" y="390"/>
        <di:waypoint x="918" y="534"/>
        <di:waypoint x="990" y="534"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F06_di" bpmnElement="P11_F06">
        <di:waypoint x="1038" y="534"/>
        <di:waypoint x="1104" y="534"/>
        <di:waypoint x="1104" y="822"/>
        <di:waypoint x="1119" y="822"/>
        <bpmndi:BPMNLabel labelStyle="P11_font">
          <dc:Bounds x="1056" y="500" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F07_di" bpmnElement="P11_F07">
        <di:waypoint x="1038" y="534"/>
        <di:waypoint x="1050" y="534"/>
        <di:waypoint x="1050" y="528"/>
        <di:waypoint x="1278" y="528"/>
        <di:waypoint x="1278" y="534"/>
        <di:waypoint x="1293" y="534"/>
        <bpmndi:BPMNLabel labelStyle="P11_font">
          <dc:Bounds x="1148" y="503" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F08_di" bpmnElement="P11_F08">
        <di:waypoint x="1257" y="822"/>
        <di:waypoint x="1266" y="822"/>
        <di:waypoint x="1266" y="534"/>
        <di:waypoint x="1293" y="534"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P11_F09_di" bpmnElement="P11_F09">
        <di:waypoint x="1431" y="534"/>
        <di:waypoint x="1518" y="534"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="P11_font">
      <dc:Font name="Arial" size="13"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
