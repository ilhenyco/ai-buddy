<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P06" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P06_collab">
    <bpmn:participant id="P06_pool" name="Проверка статуса доступа" processRef="P06_process"/>
    <bpmn:participant id="P06_accessService" name="Тестовый сервис доступов"/>
    <bpmn:messageFlow id="P06_request" name="Запрос GET" sourceRef="P06_read" targetRef="P06_accessService"/>
    <bpmn:messageFlow id="P06_response" name="Статус и ревизия" sourceRef="P06_accessService" targetRef="P06_read"/>
  </bpmn:collaboration>
  <bpmn:process id="P06_process" name="Проверка статуса доступа" isExecutable="false">
    <bpmn:documentation>Область: Прототип
Старт: Стажёр явно нажал «Проверить статус»
Результат: Отображён подтверждённый статус, последнее известное состояние при сбое либо предусмотренный следующий шаг.
Приёмка: Устаревший ответ не понижает ревизию. При отказе показан контакт бадди. Одобрение другого ресурса не открывает первую задачу.
GET /access-requests/{resourceId} вызывает GET /requests/{operationId}. При сбое serviceAvailable=false. GET /onboarding использует сохранённое состояние без внешнего вызова.
При pending стажёр может открыть другие карточки. При submitting интерфейс предлагает повтор P05. При approved возможность открыть P07 зависит от ID требуемого ресурса.</bpmn:documentation>
    <bpmn:laneSet id="P06_lanes">
      <bpmn:lane id="P06_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P06_s</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P06_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P06_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_try</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_none</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_got</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_last</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P06_s" name="Статус запрошен">
      <bpmn:outgoing>P06_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P06_check" name="Проверить права и попытку">
      <bpmn:incoming>P06_F01</bpmn:incoming>
      <bpmn:outgoing>P06_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_try" name="Есть попытка?" default="P06_F04" gatewayDirection="Diverging">
      <bpmn:incoming>P06_F02</bpmn:incoming>
      <bpmn:outgoing>P06_F03</bpmn:outgoing>
      <bpmn:outgoing>P06_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P06_none" name="Нет доступной попытки">
      <bpmn:incoming>P06_F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P06_read" name="Прочитать статус по operationId">
      <bpmn:documentation>Лист 3, строка 16. Заявка на доступ
Роль: Стажёр
Результат: В плане видны номер и статус заявки либо причина, почему её не удалось отправить.
Участие AI-buddy: Прототип. Готовит черновик. После подтверждения стажёра отправляет через сервис и показывает статус.</bpmn:documentation>
      <bpmn:incoming>P06_F03</bpmn:incoming>
      <bpmn:outgoing>P06_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_got" name="Сервис ответил?" default="P06_F07" gatewayDirection="Diverging">
      <bpmn:incoming>P06_F05</bpmn:incoming>
      <bpmn:outgoing>P06_F06</bpmn:outgoing>
      <bpmn:outgoing>P06_F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P06_last" name="Показать последнее состояние">
      <bpmn:incoming>P06_F07</bpmn:incoming>
      <bpmn:outgoing>P06_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P06_store" name="Сохранить только свежую ревизию">
      <bpmn:documentation>Лист 3, строка 17. Черновик и статус заявки
Роль: AI-buddy
Результат: Сохранены номер и статус либо показан понятный способ повтора.
Участие AI-buddy: Прототип. Предлагает обоснование и показывает ответ сервиса. При сбое даёт повторить без дубликата.</bpmn:documentation>
      <bpmn:incoming>P06_F06</bpmn:incoming>
      <bpmn:outgoing>P06_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_status" name="Статус заявки" default="P06_F12" gatewayDirection="Diverging">
      <bpmn:incoming>P06_F09</bpmn:incoming>
      <bpmn:outgoing>P06_F10</bpmn:outgoing>
      <bpmn:outgoing>P06_F11</bpmn:outgoing>
      <bpmn:outgoing>P06_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P06_wait" name="Ожидание или повтор">
      <bpmn:incoming>P06_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P06_ok" name="Одобрение показано">
      <bpmn:incoming>P06_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P06_no" name="Показать отказ и контакт бадди">
      <bpmn:documentation>Лист 3, строка 15. Доступы и инструменты
Роль: Бадди
Результат: Стажёр знает, какие доступы запросить и к кому идти с блокером.
Участие AI-buddy: Прототип. Показывает статус и контакт бадди, если заявка отклонена.</bpmn:documentation>
      <bpmn:incoming>P06_F11</bpmn:incoming>
      <bpmn:outgoing>P06_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P06_e" name="Показан следующий шаг">
      <bpmn:incoming>P06_F08</bpmn:incoming>
      <bpmn:incoming>P06_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P06_F01" sourceRef="P06_s" targetRef="P06_check"/>
    <bpmn:sequenceFlow id="P06_F02" sourceRef="P06_check" targetRef="P06_try"/>
    <bpmn:sequenceFlow id="P06_F03" sourceRef="P06_try" targetRef="P06_read" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">attemptVisible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_F04" sourceRef="P06_try" targetRef="P06_none" name="Нет"/>
    <bpmn:sequenceFlow id="P06_F05" sourceRef="P06_read" targetRef="P06_got"/>
    <bpmn:sequenceFlow id="P06_F06" sourceRef="P06_got" targetRef="P06_store" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">serviceResponded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_F07" sourceRef="P06_got" targetRef="P06_last" name="Нет"/>
    <bpmn:sequenceFlow id="P06_F08" sourceRef="P06_last" targetRef="P06_e"/>
    <bpmn:sequenceFlow id="P06_F09" sourceRef="P06_store" targetRef="P06_status"/>
    <bpmn:sequenceFlow id="P06_F10" sourceRef="P06_status" targetRef="P06_ok" name="Одобрена">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">statusApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_F11" sourceRef="P06_status" targetRef="P06_no" name="Отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">statusDenied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_F12" sourceRef="P06_status" targetRef="P06_wait" name="Ожидание"/>
    <bpmn:sequenceFlow id="P06_F13" sourceRef="P06_no" targetRef="P06_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P06_diagram" name="Проверка статуса доступа">
    <bpmndi:BPMNPlane id="P06_plane" bpmnElement="P06_collab">
