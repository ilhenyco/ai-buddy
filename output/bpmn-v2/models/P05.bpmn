<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P05" targetNamespace="urn:origination:ai-buddy:bpmn:v2" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P05_collab">
    <bpmn:participant id="P05_pool" name="Подтверждение и отправка заявки" processRef="P05_process"/>
    <bpmn:participant id="P05_accessService" name="Тестовый сервис доступов"/>
    <bpmn:messageFlow id="P05_request" name="Запрос PUT" sourceRef="P05_call" targetRef="P05_accessService"/>
    <bpmn:messageFlow id="P05_response" name="Номер и статус" sourceRef="P05_accessService" targetRef="P05_call"/>
  </bpmn:collaboration>
  <bpmn:process id="P05_process" name="Подтверждение и отправка заявки" isExecutable="false">
    <bpmn:documentation>Область: Прототип
Старт: Стажёр видит сохранённый черновик или предлагает повторить отправку
Результат: Сохранены номер и статус сервиса либо показано восстанавливаемое состояние отправки.
Приёмка: Без явного подтверждения сервис не вызывается. Два подтверждения создают одну заявку. Повтор после потери ответа использует исходные параметры и operationId.
POST /access-drafts/{draftId}/confirm. Сервер ищет единственную попытку по planId + resourceId. При известном результате возвращает его без повторного создания. При неизвестном — восстанавливает ту же операцию.
Внутренний PUT /requests/{operationId} идемпотентен. 200 означает сохранённый результат. 202 означает submitting с confirmationDraftId. 503 до вызова означает, что попытка не сохранена. Сбой записи результата также оставляет восстанавливаемую попытку.</bpmn:documentation>
    <bpmn:laneSet id="P05_lanes">
      <bpmn:lane id="P05_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P05_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_yes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_stop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P05_ensure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_db</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_known</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_wait</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05_s" name="Черновик или повтор">
      <bpmn:outgoing>P05_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P05_confirm" name="Выбрать отправку или отмену">
      <bpmn:documentation>Лист 3, строка 16. Заявка на доступ
Роль: Стажёр
Результат: В плане видны номер и статус заявки либо причина, почему её не удалось отправить.
Участие AI-buddy: Прототип. Готовит черновик. После подтверждения стажёра отправляет через сервис и показывает статус.</bpmn:documentation>
      <bpmn:incoming>P05_F01</bpmn:incoming>
      <bpmn:outgoing>P05_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P05_yes" name="Подтверждено?" default="P05_F04" gatewayDirection="Diverging">
      <bpmn:incoming>P05_F02</bpmn:incoming>
      <bpmn:outgoing>P05_F03</bpmn:outgoing>
      <bpmn:outgoing>P05_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_stop" name="Без отправки">
      <bpmn:incoming>P05_F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P05_ensure" name="Проверить права и зафиксировать попытку">
      <bpmn:incoming>P05_F03</bpmn:incoming>
      <bpmn:outgoing>P05_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_ready" name="Итог проверки" default="P05_F09" gatewayDirection="Diverging">
      <bpmn:incoming>P05_F05</bpmn:incoming>
      <bpmn:outgoing>P05_F06</bpmn:outgoing>
      <bpmn:outgoing>P05_F07</bpmn:outgoing>
      <bpmn:outgoing>P05_F08</bpmn:outgoing>
      <bpmn:outgoing>P05_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_denied" name="Запрос недоступен">
      <bpmn:incoming>P05_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P05_db" name="Попытка не сохранена">
      <bpmn:incoming>P05_F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P05_known" name="Возвращён прежний результат">
      <bpmn:incoming>P05_F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P05_call" name="Вызвать сервис и сохранить ответ">
      <bpmn:documentation>Лист 3, строка 17. Черновик и статус заявки
Роль: AI-buddy
Результат: Сохранены номер и статус либо показан понятный способ повтора.
Участие AI-buddy: Прототип. Предлагает обоснование и показывает ответ сервиса. При сбое даёт повторить без дубликата.</bpmn:documentation>
      <bpmn:incoming>P05_F09</bpmn:incoming>
      <bpmn:outgoing>P05_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_res" name="Результат сохранён?" default="P05_F12" gatewayDirection="Diverging">
      <bpmn:incoming>P05_F10</bpmn:incoming>
      <bpmn:outgoing>P05_F11</bpmn:outgoing>
      <bpmn:outgoing>P05_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P05_save" name="Показать номер и статус">
      <bpmn:incoming>P05_F11</bpmn:incoming>
      <bpmn:outgoing>P05_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_unknown" name="Показать ожидание и повтор">
      <bpmn:incoming>P05_F12</bpmn:incoming>
      <bpmn:outgoing>P05_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P05_ok" name="Номер и статус показаны">
      <bpmn:incoming>P05_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P05_wait" name="Отправка не подтверждена">
      <bpmn:incoming>P05_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P05_F01" sourceRef="P05_s" targetRef="P05_confirm"/>
    <bpmn:sequenceFlow id="P05_F02" sourceRef="P05_confirm" targetRef="P05_yes"/>
    <bpmn:sequenceFlow id="P05_F03" sourceRef="P05_yes" targetRef="P05_ensure" name="Отправить">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">explicitConfirmation</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F04" sourceRef="P05_yes" targetRef="P05_stop" name="Отмена"/>
    <bpmn:sequenceFlow id="P05_F05" sourceRef="P05_ensure" targetRef="P05_ready"/>
    <bpmn:sequenceFlow id="P05_F06" sourceRef="P05_ready" targetRef="P05_denied" name="Нет прав">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notAllowed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F07" sourceRef="P05_ready" targetRef="P05_db" name="Сбой записи">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">writeFailed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F08" sourceRef="P05_ready" targetRef="P05_known" name="Результат уже есть">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">knownResult</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F09" sourceRef="P05_ready" targetRef="P05_call" name="Готова к вызову"/>
    <bpmn:sequenceFlow id="P05_F10" sourceRef="P05_call" targetRef="P05_res"/>
    <bpmn:sequenceFlow id="P05_F11" sourceRef="P05_res" targetRef="P05_save" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resultPersisted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F12" sourceRef="P05_res" targetRef="P05_unknown" name="Нет"/>
    <bpmn:sequenceFlow id="P05_F13" sourceRef="P05_save" targetRef="P05_ok"/>
    <bpmn:sequenceFlow id="P05_F14" sourceRef="P05_unknown" targetRef="P05_wait"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P05_diagram" name="Подтверждение и отправка заявки">
    <bpmndi:BPMNPlane id="P05_plane" bpmnElement="P05_collab">
