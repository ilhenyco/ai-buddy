        <bpmndi:BPMNLabel labelStyle="P08_font">
          <dc:Bounds x="78" y="126" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_org_di" bpmnElement="P08_org" bioc:fill="#FFF3DC" bioc:stroke="#243448">
        <dc:Bounds x="249" y="54" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_split_di" bpmnElement="P08_split" bioc:fill="#FFF3DC" bioc:stroke="#243448">
        <dc:Bounds x="468" y="78" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P08_font">
          <dc:Bounds x="414" y="132" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_hr_di" bpmnElement="P08_hr" bioc:fill="#FFF3DC" bioc:stroke="#243448">
        <dc:Bounds x="597" y="54" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_lead_di" bpmnElement="P08_lead" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="945" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_goals_di" bpmnElement="P08_goals" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1170" y="228" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P08_font">
          <dc:Bounds x="1122" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_buddy_di" bpmnElement="P08_buddy" bioc:fill="#E7F5F0" bioc:stroke="#243448">
        <dc:Bounds x="597" y="342" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_intern_di" bpmnElement="P08_intern" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="771" y="486" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_learn_di" bpmnElement="P08_learn" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="945" y="486" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_done_di" bpmnElement="P08_done" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1170" y="516" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P08_font">
          <dc:Bounds x="1122" y="558" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P08_show_di" bpmnElement="P08_show" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="771" y="630" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P08_F01_di" bpmnElement="P08_F01">
        <di:waypoint x="162" y="102"/>
        <di:waypoint x="249" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F02_di" bpmnElement="P08_F02">
        <di:waypoint x="387" y="102"/>
        <di:waypoint x="468" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F03_di" bpmnElement="P08_F03">
        <di:waypoint x="516" y="102"/>
        <di:waypoint x="597" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F04_di" bpmnElement="P08_F04">
        <di:waypoint x="516" y="102"/>
        <di:waypoint x="528" y="102"/>
        <di:waypoint x="528" y="120"/>
        <di:waypoint x="582" y="120"/>
        <di:waypoint x="582" y="390"/>
        <di:waypoint x="597" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F05_di" bpmnElement="P08_F05">
        <di:waypoint x="735" y="102"/>
        <di:waypoint x="744" y="102"/>
        <di:waypoint x="744" y="678"/>
        <di:waypoint x="771" y="678"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F06_di" bpmnElement="P08_F06">
        <di:waypoint x="909" y="678"/>
