        <di:waypoint x="918" y="534"/>
        <di:waypoint x="945" y="534"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F07_di" bpmnElement="P08_F07">
        <di:waypoint x="1083" y="534"/>
        <di:waypoint x="1170" y="534"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F08_di" bpmnElement="P08_F08">
        <di:waypoint x="735" y="390"/>
        <di:waypoint x="756" y="390"/>
