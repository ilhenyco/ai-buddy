        <di:waypoint x="945" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P08_F10_di" bpmnElement="P08_F10">
        <di:waypoint x="1083" y="246"/>
        <di:waypoint x="1170" y="246"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="P08_font">
      <dc:Font name="Arial" size="13"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
