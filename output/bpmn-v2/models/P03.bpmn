        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="78" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_meet_di" bpmnElement="P03_meet" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="468" y="222" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="414" y="276" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_mark_di" bpmnElement="P03_mark" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="771" y="198" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_g_di" bpmnElement="P03_g" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="990" y="222" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="936" y="276" width="156" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_defer_di" bpmnElement="P03_defer" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1344" y="228" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1296" y="270" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_show_di" bpmnElement="P03_show" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="249" y="402" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_store_di" bpmnElement="P03_store" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1119" y="342" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_buddy_di" bpmnElement="P03_buddy" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1119" y="462" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_done_di" bpmnElement="P03_done" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1344" y="432" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1296" y="474" width="132" height="36"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P03_F01_di" bpmnElement="P03_F01">
        <di:waypoint x="162" y="246"/>
        <di:waypoint x="234" y="246"/>
        <di:waypoint x="234" y="450"/>
        <di:waypoint x="249" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F02_di" bpmnElement="P03_F02">
        <di:waypoint x="387" y="450"/>
        <di:waypoint x="396" y="450"/>
        <di:waypoint x="396" y="246"/>
        <di:waypoint x="468" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F03_di" bpmnElement="P03_F03">
        <di:waypoint x="516" y="246"/>
        <di:waypoint x="528" y="246"/>
        <di:waypoint x="528" y="102"/>
        <di:waypoint x="597" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="536" y="201" width="82" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F04_di" bpmnElement="P03_F04">
        <di:waypoint x="516" y="246"/>
        <di:waypoint x="771" y="246"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="592" y="253" width="138" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F05_di" bpmnElement="P03_F05">
        <di:waypoint x="735" y="102"/>
        <di:waypoint x="744" y="102"/>
        <di:waypoint x="744" y="246"/>
        <di:waypoint x="771" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F06_di" bpmnElement="P03_F06">
        <di:waypoint x="909" y="246"/>
        <di:waypoint x="990" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F07_di" bpmnElement="P03_F07">
        <di:waypoint x="1038" y="246"/>
        <di:waypoint x="1104" y="246"/>
        <di:waypoint x="1104" y="390"/>
        <di:waypoint x="1119" y="390"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1112" y="273" width="68" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F08_di" bpmnElement="P03_F08">
        <di:waypoint x="1038" y="246"/>
        <di:waypoint x="1050" y="246"/>
        <di:waypoint x="1050" y="264"/>
        <di:waypoint x="1098" y="264"/>
        <di:waypoint x="1098" y="510"/>
        <di:waypoint x="1119" y="510"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1029" y="378" width="61" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F09_di" bpmnElement="P03_F09">
        <di:waypoint x="1038" y="246"/>
        <di:waypoint x="1050" y="246"/>
        <di:waypoint x="1050" y="240"/>
        <di:waypoint x="1332" y="240"/>
        <di:waypoint x="1332" y="246"/>
        <di:waypoint x="1344" y="246"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1157" y="215" width="68" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F10_di" bpmnElement="P03_F10">
        <di:waypoint x="1257" y="510"/>
        <di:waypoint x="1266" y="510"/>
        <di:waypoint x="1266" y="246"/>
        <di:waypoint x="1344" y="246"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P03_F11_di" bpmnElement="P03_F11">
        <di:waypoint x="1257" y="390"/>
        <di:waypoint x="1332" y="390"/>
        <di:waypoint x="1332" y="450"/>
        <di:waypoint x="1344" y="450"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="P03_font">
      <dc:Font name="Arial" size="13"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
