        <di:waypoint x="552" y="102"/>
        <di:waypoint x="621" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="571" y="77" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
