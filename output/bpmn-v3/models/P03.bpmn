        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="438" y="288" width="156" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_mark_di" bpmnElement="P03_mark" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="795" y="210" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_g_di" bpmnElement="P03_g" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="1014" y="234" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="960" y="288" width="156" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_defer_di" bpmnElement="P03_defer" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1368" y="240" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1320" y="282" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_show_di" bpmnElement="P03_show" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="273" y="426" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_store_di" bpmnElement="P03_store" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1143" y="366" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_buddy_di" bpmnElement="P03_buddy" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1143" y="486" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P03_done_di" bpmnElement="P03_done" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1368" y="456" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P03_font">
          <dc:Bounds x="1320" y="498" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
