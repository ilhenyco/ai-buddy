<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P04" targetNamespace="urn:origination:ai-buddy:bpmn:v3" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P04_collab">
    <bpmn:participant id="P04_pool" name="Доступы по ссылке и помощь бадди" processRef="P04_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P04_process" name="Доступы по ссылке и помощь бадди" isExecutable="false">
    <bpmn:documentation>Область: Текущая концепция и условная интеграция OQ08
Старт: Стажёр открыл сообщение о доступах
Результат: Дана инструкция для внешнего действия либо подготовлен черновик условной интеграции
Приёмка: Основной путь ведёт по ссылке с помощью бадди. Открытие ссылки и галочка не означают выдачу доступа.
Функциональные требования 0.4: FR-IN-02, FR-IN-06, FR-EX-01
Вызов сервиса внутри продукта показан как условное исключение, требующее решения OQ08. Он не является общим способом выполнения всех пунктов.
Оба пути не управляют календарём. Результат внешнего действия может быть неизвестен боту. Сообщения бадди и руководителю отправляются независимо через P15.
Открытые вопросы: OQ08. Они сохраняют статус, указанный в функциональных требованиях.</bpmn:documentation>
    <bpmn:laneSet id="P04_lanes">
      <bpmn:lane id="P04_lane_B" name="Бадди">
        <bpmn:flowNodeRef>P04_guide</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P04_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_link</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_outside</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_help</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_edit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P04_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_save</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_M" name="Модель AI">
        <bpmn:flowNodeRef>P04_suggest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_s" name="Открыто сообщение доступов">
      <bpmn:outgoing>P04_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_show" name="Показать инструкцию, ссылку и бадди">
      <bpmn:documentation>Текущие требования: FR-IN-02</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 15. Доступы и инструменты. Роль источника: Бадди.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P04_F01</bpmn:incoming>
      <bpmn:outgoing>P04_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_mode" name="Прямая интеграция включена?" default="P04_F04" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F02</bpmn:incoming>
      <bpmn:outgoing>P04_F03</bpmn:outgoing>
      <bpmn:outgoing>P04_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P04_link" name="Открыть внешний инструмент">
      <bpmn:documentation>Текущие требования: FR-IN-06, FR-EX-01</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 16. Заявка на доступ. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P04_F04</bpmn:incoming>
      <bpmn:outgoing>P04_F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="P04_guide" name="Помочь получить доступ">
      <bpmn:documentation>Текущие требования: FR-EX-01</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 15. Доступы и инструменты. Роль источника: Бадди.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P04_F05</bpmn:incoming>
      <bpmn:outgoing>P04_F06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="P04_outside" name="Дальнейшее действие во внешнем сервисе">
      <bpmn:incoming>P04_F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_pick" name="Выбрать разрешённый ресурс">
      <bpmn:documentation>Исторический источник: лист 3, строка 16. Заявка на доступ. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P04_F03</bpmn:incoming>
      <bpmn:outgoing>P04_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_auth" name="Проверить ресурс и найти попытку">
      <bpmn:incoming>P04_F07</bpmn:incoming>
      <bpmn:outgoing>P04_F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_ok" name="Запрос разрешён и новый?" default="P04_F10" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F08</bpmn:incoming>
      <bpmn:outgoing>P04_F09</bpmn:outgoing>
      <bpmn:outgoing>P04_F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_existing" name="Показать состояние или отказ">
      <bpmn:incoming>P04_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P04_help" name="Нужен AI черновик?" default="P04_F12" gatewayDirection="Diverging">
      <bpmn:incoming>P04_F09</bpmn:incoming>
      <bpmn:outgoing>P04_F11</bpmn:outgoing>
      <bpmn:outgoing>P04_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P04_suggest" name="Предложить обоснование">
      <bpmn:documentation>Исторический источник: лист 3, строка 17. Черновик и статус заявки. Роль источника: AI-buddy.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P04_F11</bpmn:incoming>
      <bpmn:outgoing>P04_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P04_edit" name="Проверить или написать обоснование">
      <bpmn:incoming>P04_F12</bpmn:incoming>
      <bpmn:incoming>P04_F13</bpmn:incoming>
      <bpmn:outgoing>P04_F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P04_save" name="Сохранить точный предпросмотр">
      <bpmn:incoming>P04_F14</bpmn:incoming>
      <bpmn:outgoing>P04_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P04_e" name="Далее условный P05">
      <bpmn:incoming>P04_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_F01" sourceRef="P04_s" targetRef="P04_show"/>
    <bpmn:sequenceFlow id="P04_F02" sourceRef="P04_show" targetRef="P04_mode"/>
    <bpmn:sequenceFlow id="P04_F03" sourceRef="P04_mode" targetRef="P04_pick" name="Да по OQ08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">directIntegrationConfigured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F04" sourceRef="P04_mode" targetRef="P04_link" name="По ссылке"/>
    <bpmn:sequenceFlow id="P04_F05" sourceRef="P04_link" targetRef="P04_guide"/>
    <bpmn:sequenceFlow id="P04_F06" sourceRef="P04_guide" targetRef="P04_outside"/>
    <bpmn:sequenceFlow id="P04_F07" sourceRef="P04_pick" targetRef="P04_auth"/>
    <bpmn:sequenceFlow id="P04_F08" sourceRef="P04_auth" targetRef="P04_ok"/>
    <bpmn:sequenceFlow id="P04_F09" sourceRef="P04_ok" targetRef="P04_help" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allowedNewAttempt</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F10" sourceRef="P04_ok" targetRef="P04_existing" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F11" sourceRef="P04_help" targetRef="P04_suggest" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">draftHelpRequested</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F12" sourceRef="P04_help" targetRef="P04_edit" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F13" sourceRef="P04_suggest" targetRef="P04_edit"/>
    <bpmn:sequenceFlow id="P04_F14" sourceRef="P04_edit" targetRef="P04_save"/>
    <bpmn:sequenceFlow id="P04_F15" sourceRef="P04_save" targetRef="P04_e"/>
  </bpmn:process>
