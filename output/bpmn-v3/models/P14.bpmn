<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P14" targetNamespace="urn:origination:ai-buddy:bpmn:v3" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P14_collab">
    <bpmn:participant id="P14_pool" name="Личный вопрос стажёра и ответ через RAG" processRef="P14_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P14_process" name="Личный вопрос стажёра и ответ через RAG" isExecutable="false">
    <bpmn:documentation>Область: Текущая концепция
Старт: Стажёр написал вопрос в переписке
Результат: Показан ответ с источниками либо понятное сообщение об отсутствии ответа
Приёмка: В модель передаются только разрешённые источники. Личный вопрос не включается в плановые сообщения другим ролям.
Функциональные требования 0.4: FR-IN-03, FR-IN-07, FR-KB-01, FR-KB-02, FR-KB-03, FR-KB-04, FR-KB-05, FR-AC-01, FR-AC-02
Отбор по правам предшествует поиску и вызову модели. При отсутствии источника, сбое или тайм-ауте доступен ответ без выдуманной инструкции. Локальная Qwen и деморежим остаются за одним адаптером.
OQ01 закрыт: личный вопрос и ответ доступны только стажёру. Плановые сообщения P15 не используют эту переписку.
Три вопроса принадлежат продукту, сохраняются на стажёра и меняются только при смене stageKey. До старта — стартовый набор. Без опубликованного плана ввод и подсказки скрыты. Копии блоков наследуют тему.
Открытые вопросы: OQ07. Они сохраняют статус, указанный в функциональных требованиях.</bpmn:documentation>
    <bpmn:laneSet id="P14_lanes">
      <bpmn:lane id="P14_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P14_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P14_stage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_random</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_reuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_chips</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_filter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_help</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_lane_M" name="Модель AI">
        <bpmn:flowNodeRef>P14_model</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_s" name="Открыта личная переписка">
      <bpmn:outgoing>P14_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P14_stage" name="Текущий этап по активному плану">
      <bpmn:documentation>Текущие требования: FR-IN-07</bpmn:documentation>
      <bpmn:incoming>P14_F01</bpmn:incoming>
      <bpmn:outgoing>P14_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P14_selection" name="Тройка этапа уже сохранена?" default="P14_F04" gatewayDirection="Diverging">
      <bpmn:documentation>Текущие требования: FR-IN-07</bpmn:documentation>
      <bpmn:incoming>P14_F02</bpmn:incoming>
      <bpmn:outgoing>P14_F03</bpmn:outgoing>
      <bpmn:outgoing>P14_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_random" name="Выбрать три разных вопроса">
      <bpmn:documentation>Текущие требования: FR-IN-07</bpmn:documentation>
      <bpmn:incoming>P14_F04</bpmn:incoming>
      <bpmn:outgoing>P14_F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_reuse" name="Взять сохранённую тройку">
      <bpmn:incoming>P14_F03</bpmn:incoming>
      <bpmn:outgoing>P14_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_chips" name="Показать подсказки в чате">
      <bpmn:documentation>Текущие требования: FR-IN-07</bpmn:documentation>
      <bpmn:incoming>P14_F05</bpmn:incoming>
      <bpmn:incoming>P14_F06</bpmn:incoming>
      <bpmn:outgoing>P14_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P14_ask" name="Нажать подсказку или написать вопрос">
      <bpmn:documentation>Текущие требования: FR-IN-03</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 12. Знакомство и вопросы. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P14_F07</bpmn:incoming>
      <bpmn:outgoing>P14_F08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P14_filter" name="Проверить пользователя и права">
      <bpmn:documentation>Текущие требования: FR-KB-02, FR-AC-01, FR-AC-02</bpmn:documentation>
      <bpmn:incoming>P14_F08</bpmn:incoming>
      <bpmn:outgoing>P14_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_retrieve" name="Найти подходящие фрагменты RAG">
      <bpmn:documentation>Текущие требования: FR-KB-01, FR-KB-02</bpmn:documentation>
      <bpmn:incoming>P14_F09</bpmn:incoming>
      <bpmn:outgoing>P14_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P14_g" name="Есть разрешённый источник?" default="P14_F12" gatewayDirection="Diverging">
      <bpmn:incoming>P14_F10</bpmn:incoming>
      <bpmn:outgoing>P14_F11</bpmn:outgoing>
      <bpmn:outgoing>P14_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_model" name="Сформировать ответ по фрагментам">
      <bpmn:incoming>P14_F11</bpmn:incoming>
      <bpmn:outgoing>P14_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_validate" name="Проверить источники и ссылки">
      <bpmn:documentation>Текущие требования: FR-KB-03</bpmn:documentation>
      <bpmn:incoming>P14_F13</bpmn:incoming>
      <bpmn:outgoing>P14_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P14_valid" name="Ответ пригоден?" default="P14_F16" gatewayDirection="Diverging">
      <bpmn:incoming>P14_F14</bpmn:incoming>
      <bpmn:outgoing>P14_F15</bpmn:outgoing>
      <bpmn:outgoing>P14_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P14_answer" name="Показать ответ стажёру">
      <bpmn:documentation>Текущие требования: FR-KB-03</bpmn:documentation>
      <bpmn:incoming>P14_F15</bpmn:incoming>
      <bpmn:outgoing>P14_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P14_help" name="Объяснить проблему и дать контакт">
      <bpmn:documentation>Текущие требования: FR-KB-04, FR-KB-05</bpmn:documentation>
      <bpmn:incoming>P14_F12</bpmn:incoming>
      <bpmn:incoming>P14_F16</bpmn:incoming>
      <bpmn:outgoing>P14_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P14_e" name="Стажёр получил ответ">
      <bpmn:incoming>P14_F17</bpmn:incoming>
      <bpmn:incoming>P14_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_F01" sourceRef="P14_s" targetRef="P14_stage"/>
    <bpmn:sequenceFlow id="P14_F02" sourceRef="P14_stage" targetRef="P14_selection"/>
    <bpmn:sequenceFlow id="P14_F03" sourceRef="P14_selection" targetRef="P14_reuse" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sameStage</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P14_F04" sourceRef="P14_selection" targetRef="P14_random" name="Нет"/>
    <bpmn:sequenceFlow id="P14_F05" sourceRef="P14_random" targetRef="P14_chips"/>
    <bpmn:sequenceFlow id="P14_F06" sourceRef="P14_reuse" targetRef="P14_chips"/>
    <bpmn:sequenceFlow id="P14_F07" sourceRef="P14_chips" targetRef="P14_ask"/>
    <bpmn:sequenceFlow id="P14_F08" sourceRef="P14_ask" targetRef="P14_filter"/>
    <bpmn:sequenceFlow id="P14_F09" sourceRef="P14_filter" targetRef="P14_retrieve"/>
    <bpmn:sequenceFlow id="P14_F10" sourceRef="P14_retrieve" targetRef="P14_g"/>
    <bpmn:sequenceFlow id="P14_F11" sourceRef="P14_g" targetRef="P14_model" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">allowedSourceFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P14_F12" sourceRef="P14_g" targetRef="P14_help" name="Нет"/>
    <bpmn:sequenceFlow id="P14_F13" sourceRef="P14_model" targetRef="P14_validate"/>
    <bpmn:sequenceFlow id="P14_F14" sourceRef="P14_validate" targetRef="P14_valid"/>
    <bpmn:sequenceFlow id="P14_F15" sourceRef="P14_valid" targetRef="P14_answer" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">replyValid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P14_F16" sourceRef="P14_valid" targetRef="P14_help" name="Сбой или нет"/>
    <bpmn:sequenceFlow id="P14_F17" sourceRef="P14_answer" targetRef="P14_e"/>
    <bpmn:sequenceFlow id="P14_F18" sourceRef="P14_help" targetRef="P14_e"/>
  </bpmn:process>
