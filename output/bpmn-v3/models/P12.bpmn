        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="786" y="192" width="156" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_yes_di" bpmnElement="P12_yes" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="969" y="54" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_wait_di" bpmnElement="P12_wait" bioc:fill="#F0E8FF" bioc:stroke="#243448">
        <dc:Bounds x="969" y="174" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_e_di" bpmnElement="P12_e" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1194" y="84" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="1146" y="126" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_w_di" bpmnElement="P12_w" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1194" y="204" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="1146" y="246" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_handoff_di" bpmnElement="P12_handoff" bioc:fill="#E7F5F0" bioc:stroke="#243448">
        <dc:Bounds x="447" y="330" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_s_di" bpmnElement="P12_s" bioc:fill="#E1F5E6" bioc:stroke="#243448">
        <dc:Bounds x="150" y="516" width="36" height="36"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="102" y="558" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P12_result_di" bpmnElement="P12_result" bioc:fill="#E7F1FF" bioc:stroke="#243448">
        <dc:Bounds x="273" y="486" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P12_F01_di" bpmnElement="P12_F01">
        <di:waypoint x="186" y="534"/>
        <di:waypoint x="273" y="534"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F02_di" bpmnElement="P12_F02">
        <di:waypoint x="411" y="534"/>
        <di:waypoint x="420" y="534"/>
        <di:waypoint x="420" y="378"/>
        <di:waypoint x="447" y="378"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F03_di" bpmnElement="P12_F03">
        <di:waypoint x="585" y="378"/>
        <di:waypoint x="594" y="378"/>
        <di:waypoint x="594" y="162"/>
        <di:waypoint x="621" y="162"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F04_di" bpmnElement="P12_F04">
        <di:waypoint x="759" y="162"/>
        <di:waypoint x="840" y="162"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F05_di" bpmnElement="P12_F05">
        <di:waypoint x="888" y="162"/>
        <di:waypoint x="900" y="162"/>
        <di:waypoint x="900" y="102"/>
        <di:waypoint x="969" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="919" y="77" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F06_di" bpmnElement="P12_F06">
        <di:waypoint x="888" y="162"/>
        <di:waypoint x="954" y="162"/>
        <di:waypoint x="954" y="222"/>
        <di:waypoint x="969" y="222"/>
        <bpmndi:BPMNLabel labelStyle="P12_font">
          <dc:Bounds x="922" y="137" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F07_di" bpmnElement="P12_F07">
        <di:waypoint x="1107" y="102"/>
        <di:waypoint x="1194" y="102"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P12_F08_di" bpmnElement="P12_F08">
