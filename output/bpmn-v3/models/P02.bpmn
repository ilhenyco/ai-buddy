<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P02" targetNamespace="urn:origination:ai-buddy:bpmn:v3" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P02_collab">
    <bpmn:participant id="P02_pool" name="Первый вход в переписку" processRef="P02_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P02_process" name="Первый вход в переписку" isExecutable="false">
    <bpmn:documentation>Область: Текущая концепция
Старт: Стажёр открывает бот
Результат: Открыта собственная переписка или показано понятное состояние отсутствия плана
Приёмка: Стажёр видит адресованные ему сообщения. Отсутствие плана не раскрывает чужие сообщения.
Функциональные требования 0.4: FR-IN-01, FR-IN-05, FR-AC-01
Среда работы и способ входа — OQ02. Модель не требует отдельного кабинета и трёх обязательных экранов-карточек.
История переписки — предложение FR-IN-05. Новые плановые сообщения инициирует P15, а не открытие чата. AI ответы выполняются по P14.
Открытые вопросы: OQ02. Они сохраняют статус, указанный в функциональных требованиях.</bpmn:documentation>
    <bpmn:laneSet id="P02_lanes">
      <bpmn:lane id="P02_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P02_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_has</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_home</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_blocked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_s" name="Стажёр открыл бот">
      <bpmn:outgoing>P02_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P02_login" name="Подтвердить свою учётную запись">
      <bpmn:documentation>Исторический источник: лист 3, строка 8. Первый вход. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P02_F01</bpmn:incoming>
      <bpmn:incoming>P02_F06</bpmn:incoming>
      <bpmn:outgoing>P02_F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P02_session" name="Проверить личность и назначение">
      <bpmn:documentation>Текущие требования: FR-AC-01</bpmn:documentation>
      <bpmn:incoming>P02_F02</bpmn:incoming>
      <bpmn:outgoing>P02_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_signed" name="Пользователь определён?" default="P02_F05" gatewayDirection="Diverging">
      <bpmn:incoming>P02_F03</bpmn:incoming>
      <bpmn:outgoing>P02_F04</bpmn:outgoing>
      <bpmn:outgoing>P02_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_err" name="Показать ошибку входа">
      <bpmn:incoming>P02_F05</bpmn:incoming>
      <bpmn:outgoing>P02_F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_load" name="Найти сценарий стажёра">
      <bpmn:incoming>P02_F04</bpmn:incoming>
      <bpmn:outgoing>P02_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_has" name="План опубликован?" default="P02_F09" gatewayDirection="Diverging">
      <bpmn:incoming>P02_F07</bpmn:incoming>
      <bpmn:outgoing>P02_F08</bpmn:outgoing>
      <bpmn:outgoing>P02_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P02_contact" name="Показать известный контакт руководителя">
      <bpmn:incoming>P02_F09</bpmn:incoming>
      <bpmn:outgoing>P02_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_home" name="Открыть сообщения и инструкции">
      <bpmn:documentation>Текущие требования: FR-IN-01, FR-IN-05</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 9. Карточка «Мой старт». Роль источника: AI-buddy.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P02_F08</bpmn:incoming>
      <bpmn:outgoing>P02_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P02_choose" name="Читать сообщение или задать вопрос">
      <bpmn:incoming>P02_F11</bpmn:incoming>
      <bpmn:outgoing>P02_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P02_e" name="Переписка открыта">
      <bpmn:incoming>P02_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P02_blocked" name="Ожидается публикация">
      <bpmn:incoming>P02_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_F01" sourceRef="P02_s" targetRef="P02_login"/>
    <bpmn:sequenceFlow id="P02_F02" sourceRef="P02_login" targetRef="P02_session"/>
    <bpmn:sequenceFlow id="P02_F03" sourceRef="P02_session" targetRef="P02_signed"/>
    <bpmn:sequenceFlow id="P02_F04" sourceRef="P02_signed" targetRef="P02_load" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">identityKnown</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F05" sourceRef="P02_signed" targetRef="P02_err" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F06" sourceRef="P02_err" targetRef="P02_login"/>
    <bpmn:sequenceFlow id="P02_F07" sourceRef="P02_load" targetRef="P02_has"/>
    <bpmn:sequenceFlow id="P02_F08" sourceRef="P02_has" targetRef="P02_home" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">publishedPlanVisible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F09" sourceRef="P02_has" targetRef="P02_contact" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F10" sourceRef="P02_contact" targetRef="P02_blocked"/>
    <bpmn:sequenceFlow id="P02_F11" sourceRef="P02_home" targetRef="P02_choose"/>
    <bpmn:sequenceFlow id="P02_F12" sourceRef="P02_choose" targetRef="P02_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P02_diagram" name="Первый вход в переписку">
    <bpmndi:BPMNPlane id="P02_plane" bpmnElement="P02_collab">
