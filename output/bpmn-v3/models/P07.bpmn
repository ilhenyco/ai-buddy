<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P07" targetNamespace="urn:origination:ai-buddy:bpmn:v3" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P07_collab">
    <bpmn:participant id="P07_pool" name="Подготовка к первой задаче" processRef="P07_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P07_process" name="Подготовка к первой задаче" isExecutable="false">
    <bpmn:documentation>Область: Текущая концепция и условная проверка OQ08
Старт: Стажёр открыл сообщение о первой задаче
Результат: Показаны инструкция и помощь либо блокер конкретного защищённого материала
Приёмка: Проверка защищённого материала не блокирует рассылки. Одобрение чужого ресурса не открывает закрытую постановку.
Функциональные требования 0.4: FR-IN-06
Постановка и помощь выполняются людьми. Открытие ссылки не означает готовность или выполнение задачи.
Защищённый материал внутри бота и проверка статуса сервиса сохранены как условный вариант OQ08. Даже его блокировка не влияет на даты P00 и P15.
Открытые вопросы: OQ08. Они сохраняют статус, указанный в функциональных требованиях.</bpmn:documentation>
    <bpmn:laneSet id="P07_lanes">
      <bpmn:lane id="P07_lane_L" name="Руководитель">
        <bpmn:flowNodeRef>P07_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_lead</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_lane_I" name="Стажёр">
        <bpmn:flowNodeRef>P07_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_mark</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_lane_A" name="Приложение">
        <bpmn:flowNodeRef>P07_base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_protected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_block</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_store</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_s" name="Задача согласована">
      <bpmn:outgoing>P07_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P07_lead" name="Передать задачу, критерии и ссылки">
      <bpmn:documentation>Исторический источник: лист 3, строка 14. План адаптации и первая задача. Роль источника: Руководитель.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P07_F01</bpmn:incoming>
      <bpmn:outgoing>P07_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="P07_open" name="Открыть сообщение о задаче">
      <bpmn:documentation>Исторический источник: лист 3, строка 19. Старт первой задачи. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P07_F02</bpmn:incoming>
      <bpmn:outgoing>P07_F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P07_base" name="Показать инструкцию и контакт бадди">
      <bpmn:documentation>Исторический источник: лист 3, строка 18. Подготовка первой задачи. Роль источника: AI-buddy.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P07_F03</bpmn:incoming>
      <bpmn:outgoing>P07_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_protected" name="В боте есть закрытый материал?" default="P07_F06" gatewayDirection="Diverging">
      <bpmn:incoming>P07_F04</bpmn:incoming>
      <bpmn:outgoing>P07_F05</bpmn:outgoing>
      <bpmn:outgoing>P07_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_check" name="Проверить именно нужный доступ">
      <bpmn:incoming>P07_F05</bpmn:incoming>
      <bpmn:outgoing>P07_F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_g" name="Доступ подтверждён?" default="P07_F09" gatewayDirection="Diverging">
      <bpmn:incoming>P07_F07</bpmn:incoming>
      <bpmn:outgoing>P07_F08</bpmn:outgoing>
      <bpmn:outgoing>P07_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_block" name="Показать причину и помощь">
      <bpmn:incoming>P07_F09</bpmn:incoming>
      <bpmn:outgoing>P07_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_stop" name="Можно продолжать другие периоды">
      <bpmn:incoming>P07_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P07_show" name="Показать разрешённые материалы">
      <bpmn:documentation>Исторический источник: лист 3, строка 18. Подготовка первой задачи. Роль источника: AI-buddy.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P07_F06</bpmn:incoming>
      <bpmn:incoming>P07_F08</bpmn:incoming>
      <bpmn:outgoing>P07_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P07_choose" name="Открыть ссылки или отметить пункт">
      <bpmn:documentation>Текущие требования: FR-IN-06</bpmn:documentation>
      <bpmn:documentation>Исторический источник: лист 3, строка 19. Старт первой задачи. Роль источника: Стажёр.
После уточнения концепции поведение и роль AI определяются текущими требованиями и этой моделью; старые формулировки источника не являются новым условием выполнения.</bpmn:documentation>
      <bpmn:incoming>P07_F11</bpmn:incoming>
      <bpmn:outgoing>P07_F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P07_mark" name="Изменить отметку?" default="P07_F14" gatewayDirection="Diverging">
      <bpmn:incoming>P07_F12</bpmn:incoming>
      <bpmn:outgoing>P07_F13</bpmn:outgoing>
      <bpmn:outgoing>P07_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_store" name="Сохранить выбранную отметку">
      <bpmn:incoming>P07_F13</bpmn:incoming>
      <bpmn:outgoing>P07_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_e" name="Подготовка вне бота">
      <bpmn:incoming>P07_F14</bpmn:incoming>
      <bpmn:incoming>P07_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P07_F01" sourceRef="P07_s" targetRef="P07_lead"/>
    <bpmn:sequenceFlow id="P07_F02" sourceRef="P07_lead" targetRef="P07_open"/>
    <bpmn:sequenceFlow id="P07_F03" sourceRef="P07_open" targetRef="P07_base"/>
    <bpmn:sequenceFlow id="P07_F04" sourceRef="P07_base" targetRef="P07_protected"/>
    <bpmn:sequenceFlow id="P07_F05" sourceRef="P07_protected" targetRef="P07_check" name="Да по OQ08">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">protectedMaterialConfigured</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_F06" sourceRef="P07_protected" targetRef="P07_show" name="Нет"/>
    <bpmn:sequenceFlow id="P07_F07" sourceRef="P07_check" targetRef="P07_g"/>
    <bpmn:sequenceFlow id="P07_F08" sourceRef="P07_g" targetRef="P07_show" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">requiredResourceApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_F09" sourceRef="P07_g" targetRef="P07_block" name="Нет"/>
    <bpmn:sequenceFlow id="P07_F10" sourceRef="P07_block" targetRef="P07_stop"/>
    <bpmn:sequenceFlow id="P07_F11" sourceRef="P07_show" targetRef="P07_choose"/>
    <bpmn:sequenceFlow id="P07_F12" sourceRef="P07_choose" targetRef="P07_mark"/>
    <bpmn:sequenceFlow id="P07_F13" sourceRef="P07_mark" targetRef="P07_store" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">markChanged</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_F14" sourceRef="P07_mark" targetRef="P07_e" name="Нет"/>
    <bpmn:sequenceFlow id="P07_F15" sourceRef="P07_store" targetRef="P07_e"/>
  </bpmn:process>
