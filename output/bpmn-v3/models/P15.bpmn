        <di:waypoint x="606" y="222"/>
        <di:waypoint x="621" y="222"/>
        <bpmndi:BPMNLabel labelStyle="P15_font">
          <dc:Bounds x="576" y="137" width="30" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_F04_di" bpmnElement="P15_F04">
        <di:waypoint x="540" y="162"/>
        <di:waypoint x="552" y="162"/>
        <di:waypoint x="552" y="102"/>
        <di:waypoint x="672" y="102"/>
        <bpmndi:BPMNLabel labelStyle="P15_font">
          <dc:Bounds x="596" y="77" width="33" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P15_F05_di" bpmnElement="P15_F05">
