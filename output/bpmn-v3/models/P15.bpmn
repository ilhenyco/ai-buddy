        <bpmndi:BPMNLabel labelStyle="P15_font">
          <dc:Bounds x="624" y="126" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P15_targets_di" bpmnElement="P15_targets" bioc:fill="#EEF2F8" bioc:stroke="#243448">
