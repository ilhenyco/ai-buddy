<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_P00" targetNamespace="urn:origination:ai-buddy:bpmn:v3" exporter="Origination AI-buddy">
  <bpmn:collaboration id="P00_collab">
    <bpmn:participant id="P00_pool" name="Весь путь и независимые периоды" processRef="P00_process"/>
  </bpmn:collaboration>
  <bpmn:process id="P00_process" name="Весь путь и независимые периоды" isExecutable="false">
    <bpmn:documentation>Область: Текущая концепция
Старт: Выход согласован, руководитель настраивает сценарий
Результат: Календарные сообщения обработаны независимо от отметок и выполнения внешней работы
Приёмка: Незаполненный чек-лист и незавершённая встреча не задерживают рассылку следующего периода.
Функциональные требования 0.4: FR-CY-01, FR-CY-02
Каждая ветка календаря запускается независимо. Задачи отправки не ожидают выполнения чек-листов, курсов или встреч. Конечные события относятся к рассылке, а не к кадровому закрытию стажировки.
Показаны восемь блоков исходного шаблона. Удалённый блок не создаёт таймер; практика условна по применимости. Даты — параметры активной публикации. Действия P03–P14 запускаются по сообщениям и запросам участников.
Открытые вопросы: OQ04. Они сохраняют статус, указанный в функциональных требованиях.</bpmn:documentation>
    <bpmn:laneSet id="P00_lanes">
      <bpmn:lane id="P00_lane_R" name="Календарь программы">
        <bpmn:flowNodeRef>P00_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_first</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_week</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_adapt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_practice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_mid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_final</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_last</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_after</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendfirst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendweek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendadapt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendpractice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendmid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendfinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendlast</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_sendafter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_e8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P00_s" name="Выход согласован">
      <bpmn:outgoing>P00_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="P00_prep" name="P01 Опубликовать сценарий">
      <bpmn:documentation>Обзорная свёртка. Детали находятся в моделях с указанными идентификаторами.</bpmn:documentation>
      <bpmn:incoming>P00_F01</bpmn:incoming>
      <bpmn:outgoing>P00_F02</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="P00_fork" name="">
      <bpmn:documentation>Текущие требования: FR-CY-01, FR-CY-02</bpmn:documentation>
      <bpmn:incoming>P00_F02</bpmn:incoming>
      <bpmn:outgoing>P00_F03</bpmn:outgoing>
      <bpmn:outgoing>P00_F04</bpmn:outgoing>
      <bpmn:outgoing>P00_F05</bpmn:outgoing>
      <bpmn:outgoing>P00_F06</bpmn:outgoing>
      <bpmn:outgoing>P00_F07</bpmn:outgoing>
      <bpmn:outgoing>P00_F08</bpmn:outgoing>
      <bpmn:outgoing>P00_F09</bpmn:outgoing>
      <bpmn:outgoing>P00_F10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="P00_first" name="Дата старта">
      <bpmn:incoming>P00_F03</bpmn:incoming>
      <bpmn:outgoing>P00_F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_first_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.startAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_week" name="Дата первой недели">
      <bpmn:incoming>P00_F04</bpmn:incoming>
      <bpmn:outgoing>P00_F12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_week_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.firstWeekAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_adapt" name="Дата адаптации">
      <bpmn:incoming>P00_F05</bpmn:incoming>
      <bpmn:outgoing>P00_F13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_adapt_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.adaptationAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_practice" name="Дата практики при наличии блока">
      <bpmn:incoming>P00_F06</bpmn:incoming>
      <bpmn:outgoing>P00_F14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_practice_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.practiceAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_mid" name="Дата экватора">
      <bpmn:incoming>P00_F07</bpmn:incoming>
      <bpmn:outgoing>P00_F15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_mid_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.midpointAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_final" name="Месяц до финала">
      <bpmn:incoming>P00_F08</bpmn:incoming>
      <bpmn:outgoing>P00_F16</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_final_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.finalPreparationAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_last" name="Последняя неделя">
      <bpmn:incoming>P00_F09</bpmn:incoming>
      <bpmn:outgoing>P00_F17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_last_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.finalWeekAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="P00_after" name="После окончания">
      <bpmn:incoming>P00_F10</bpmn:incoming>
      <bpmn:outgoing>P00_F18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P00_after_timer">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${plan.afterEndAt}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="P00_sendfirst" name="P15 Сообщения старта P02">
      <bpmn:incoming>P00_F11</bpmn:incoming>
      <bpmn:outgoing>P00_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendweek" name="P15 Первая неделя P03–P07">
      <bpmn:incoming>P00_F12</bpmn:incoming>
      <bpmn:outgoing>P00_F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendadapt" name="P15 Сообщения адаптации P08">
      <bpmn:incoming>P00_F13</bpmn:incoming>
      <bpmn:outgoing>P00_F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendpractice" name="P15 Памятка по практике P09">
      <bpmn:incoming>P00_F14</bpmn:incoming>
      <bpmn:outgoing>P00_F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendmid" name="P15 Сообщения экватора P10">
      <bpmn:incoming>P00_F15</bpmn:incoming>
      <bpmn:outgoing>P00_F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendfinal" name="P15 Подготовка финала P11">
      <bpmn:incoming>P00_F16</bpmn:incoming>
      <bpmn:outgoing>P00_F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendlast" name="P15 Напоминания финала P12">
      <bpmn:incoming>P00_F17</bpmn:incoming>
      <bpmn:outgoing>P00_F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_sendafter" name="P15 Следующие шаги P13">
      <bpmn:incoming>P00_F18</bpmn:incoming>
      <bpmn:outgoing>P00_F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P00_e1" name="Старт разослан">
      <bpmn:incoming>P00_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e2" name="Адаптация разослана">
      <bpmn:incoming>P00_F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e3" name="Экватор разослан">
      <bpmn:incoming>P00_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e4" name="Подготовка разослана">
      <bpmn:incoming>P00_F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e5" name="Финал разослан">
      <bpmn:incoming>P00_F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e6" name="Завершение разослано">
      <bpmn:incoming>P00_F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e7" name="Неделя разослана">
      <bpmn:incoming>P00_F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P00_e8" name="Практика разослана">
      <bpmn:incoming>P00_F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P00_F01" sourceRef="P00_s" targetRef="P00_prep"/>
    <bpmn:sequenceFlow id="P00_F02" sourceRef="P00_prep" targetRef="P00_fork"/>
