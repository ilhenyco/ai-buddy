        <bpmndi:BPMNLabel labelStyle="P17_font">
          <dc:Bounds x="612" y="414" width="156" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_bad_di" bpmnElement="P17_bad" bioc:fill="#D6E8ED" bioc:stroke="#243448">
