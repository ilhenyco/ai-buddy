        <bpmndi:BPMNLabel labelStyle="P17_font">
          <dc:Bounds x="798" y="348" width="132" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_build_di" bpmnElement="P17_build" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="795" y="396" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_ready_di" bpmnElement="P17_ready" bioc:fill="#FFF1D0" bioc:stroke="#243448">
        <dc:Bounds x="1014" y="360" width="48" height="48"/>
        <bpmndi:BPMNLabel labelStyle="P17_font">
          <dc:Bounds x="960" y="414" width="156" height="48"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_save_di" bpmnElement="P17_save" bioc:fill="#EEF2F8" bioc:stroke="#243448">
        <dc:Bounds x="1143" y="276" width="138" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_fail_di" bpmnElement="P17_fail" bioc:fill="#D6E8ED" bioc:stroke="#243448">
        <dc:Bounds x="1194" y="426" width="36" height="36"/>
